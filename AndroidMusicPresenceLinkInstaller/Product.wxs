						<Component Id="ScrcpyExeComponent" Guid="f3ff0aa7-5504-4cc3-83c9-a3079ef36555" NeverOverwrite="yes" Permanent="yes">
							<File Id="ScrcpyExe" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\scrcpy.exe" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="ScrcpyExe" Type="string" Value="1" KeyPath="yes" />
