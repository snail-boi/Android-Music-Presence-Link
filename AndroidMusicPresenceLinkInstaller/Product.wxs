			<Directory Id="ProgramMenuFolder" Name="Programs">
				<Directory Id="ApplicationProgramsFolder" Name="AndroidMusicPresenceLink" />
			</Directory>
			<Directory Id="DesktopFolder" Name="Desktop" />
		</Directory>

		<DirectoryRef Id="ApplicationProgramsFolder">
			<Component Id="StartMenuShortcutComponent" Guid="1003877f-aad0-461d-af32-5df5f2aa6750">
				<Condition>CREATE_STARTMENU_SHORTCUT = "1"</Condition>
				<Shortcut Id="StartMenuShortcut"
						  Name="AndroidMusicPresenceLink"
						  Description="Launch AndroidMusicPresenceLink"
						  Target="[INSTALLFOLDER]AndroidMusicPresenceLink.exe"
						  WorkingDirectory="INSTALLFOLDER" />
				<RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink"
							   Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>

		<DirectoryRef Id="DesktopFolder">
			<Component Id="DesktopShortcutComponent" Guid="e39e8e50-d757-4df1-b4d5-f62099b80e74">
				<Condition>CREATE_DESKTOP_SHORTCUT = "1"</Condition>
				<Shortcut Id="DesktopShortcut"
						  Name="AndroidMusicPresenceLink"
						  Description="Launch AndroidMusicPresenceLink"
						  Target="[INSTALLFOLDER]AndroidMusicPresenceLink.exe"
						  WorkingDirectory="INSTALLFOLDER" />
				<RemoveFile Id="RemoveDesktopShortcutFile" Name="AndroidMusicPresenceLink.lnk" On="uninstall" />
				<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink"
							   Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
			</Component>
		</DirectoryRef>

		<Feature Id="Complete" Title="AndroidMusicPresenceLink" Level="1">

			<!-- Main App -->
			<ComponentRef Id="AndroidMusicPresenceExeComponent" />
			<ComponentRef Id="AndroidMusicPresenceDllComponent" />
			<ComponentRef Id="AndroidMusicPresenceDepsComponent" />
			<ComponentRef Id="AndroidMusicPresenceRuntimeConfigComponent" />
			<ComponentRef Id="WinRtRuntimeComponent" />
			<ComponentRef Id="WindowsSdkNetComponent" />
			<ComponentRef Id="TrayIconsComponent" />

			<!-- AppData -->
			<ComponentRef Id="AppDataSnailFolderComponent" />
			<ComponentRef Id="AppDataResourcesFolderComponent" />
			<ComponentRef Id="AdbExeComponent" />
			<ComponentRef Id="AdbWinApiDllComponent" />
			<ComponentRef Id="AdbWinUsbApiDllComponent" />
			<ComponentRef Id="AvcodecDllComponent" />
			<ComponentRef Id="AvformatDllComponent" />
