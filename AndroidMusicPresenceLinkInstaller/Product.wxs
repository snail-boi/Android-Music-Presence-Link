						<Component Id="LibusbDllComponent" Guid="05b49223-c974-4fa3-8fd6-1a605213fdf8" NeverOverwrite="yes" Permanent="yes">
							<File Id="LibusbDll" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\libusb-1.0.dll" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="LibusbDll" Type="string" Value="1" KeyPath="yes" />
