<?xml version="1.0" encoding="UTF-8"?>
<?include Version.wxi ?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
	<Product Id="*" Name="AndroidMusicPresenceLink" Language="1033"
			 Version="$(var.ProductVersion)" Manufacturer="Snail"
			 UpgradeCode="e5fefbf4-6207-4d9c-9e5e-6db2c2eaa8a1">

		<Package InstallerVersion="500" Compressed="yes"
				 InstallScope="perMachine" Platform="x86" />

		<Media Id="1" Cabinet="media1.cab" EmbedCab="yes"
			   CompressionLevel="high" />

		<Upgrade Id="e5fefbf4-6207-4d9c-9e5e-6db2c2eaa8a1">
			<UpgradeVersion Minimum="0.0.0" Maximum="99.0.0"
							IncludeMinimum="yes" IncludeMaximum="no"
							Property="OLDPRODUCTS" />
		</Upgrade>

		<InstallExecuteSequence>
			<RemoveExistingProducts Before="InstallInitialize" />
		</InstallExecuteSequence>

		<Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" />
		<Property Id="CREATE_STARTMENU_SHORTCUT" Value="1" />

		<Directory Id="TARGETDIR" Name="SourceDir">
			<Directory Id="ProgramFilesFolder">
				<Directory Id="INSTALLFOLDER" Name="AndroidMusicPresenceLink">

					<!-- Main App Files -->
					<Component Id="AndroidMusicPresenceExeComponent" Guid="b9e289b8-37d9-4c21-9b3c-07f1192368b6">
						<File Id="AndroidMusicPresenceExe"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\AndroidMusicPresenceLink.exe"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Component Id="AndroidMusicPresenceDllComponent" Guid="4032a71e-680c-4fbf-a8e9-13949bf374be">
						<File Id="AndroidMusicPresenceDll"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\AndroidMusicPresenceLink.dll"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Component Id="AndroidMusicPresenceDepsComponent" Guid="f4f1c82f-7cb8-4e70-9bb2-b503c83ac742">
						<File Id="AndroidMusicPresenceDeps"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\AndroidMusicPresenceLink.deps.json"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Component Id="AndroidMusicPresenceRuntimeConfigComponent" Guid="171bb8dc-17fb-4a0e-aac5-35810d37763f">
						<File Id="AndroidMusicPresenceRuntimeConfig"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\AndroidMusicPresenceLink.runtimeconfig.json"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Component Id="WinRtRuntimeComponent" Guid="0c7300b6-2d08-4a25-91d2-2bb5180fe4d6">
						<File Id="WinRtRuntimeDll"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\WinRT.Runtime.dll"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Component Id="WindowsSdkNetComponent" Guid="d8e8c923-9b7d-4c11-bb15-4e1ead30e1e1">
						<File Id="WindowsSdkNetDll"
							  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Microsoft.Windows.SDK.NET.dll"
							  KeyPath="yes" Vital="yes" />
					</Component>

					<Directory Id="TrayIconsFolder" Name="Tray_Icons">
						<Component Id="TrayIconsComponent" Guid="5f25fdb2-39f7-41e4-a6fe-df72a06a1e04">
							<File Id="TrayActiveUsbIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_Active_USB.ico"
								  KeyPath="yes" Vital="yes" />
							<File Id="TrayActiveWifiIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_Active_WiFi.ico"
								  Vital="yes" />
							<File Id="TrayNoDeviceIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_NoDevice.ico"
								  Vital="yes" />
							<File Id="TrayScrcpyUsbIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_Scrcpy_USB.ico"
								  Vital="yes" />
							<File Id="TrayScrcpyWifiIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_Scrcpy_WiFi.ico"
								  Vital="yes" />
							<File Id="TrayWifiNoportIco"
								  Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Tray_Icons\Tray_WiFi_Noport.ico"
								  Vital="yes" />
						</Component>
					</Directory>

				</Directory>
			</Directory>

			<Directory Id="AppDataFolder">
				<Directory Id="AppDataSnailFolder" Name="Snail">

					<Component Id="AppDataSnailFolderComponent" Guid="63e2cf13-4a9f-4bd9-8a05-7f21ea5b1857">
						<CreateFolder />
						<RemoveFolder Id="RemoveAppDataSnailFolder" On="uninstall" />
						<RegistryValue Root="HKCU"
									   Key="Software\AndroidMusicPresenceLink"
									   Name="Installed"
									   Type="integer"
									   Value="1"
									   KeyPath="yes" />
					</Component>

					<Directory Id="AppDataResourcesFolder" Name="Resources">

						<Component Id="AppDataResourcesFolderComponent" Guid="ad9cc4a6-4a57-4e1f-9af2-1cb0df7cd20c">
							<CreateFolder />
							<RemoveFolder Id="RemoveAppDataResourcesFolder" On="uninstall" />
							<RegistryValue Root="HKCU"
									   Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="Installed"
									   Type="integer"
									   Value="1"
									   KeyPath="yes" />
						</Component>

						<!-- Resource Components (NeverOverwrite + Permanent) -->
						<Component Id="AdbExeComponent" Guid="31885861-f824-4e6c-b0be-7485b6904dd7" NeverOverwrite="yes" Permanent="yes">
							<File Id="AdbExe" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\adb.exe" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="AdbExe" Type="string" Value="1" KeyPath="yes" />
						</Component>

						<Component Id="AdbWinApiDllComponent" Guid="86ff62c3-cc10-4bf7-81c8-6b8c81555c32" NeverOverwrite="yes" Permanent="yes">
							<File Id="AdbWinApiDll" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\AdbWinApi.dll" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="AdbWinApiDll" Type="string" Value="1" KeyPath="yes" />
						</Component>

						<Component Id="AdbWinUsbApiDllComponent" Guid="0ef2305f-2c3d-4c36-9c18-73a5ce8864c7" NeverOverwrite="yes" Permanent="yes">
