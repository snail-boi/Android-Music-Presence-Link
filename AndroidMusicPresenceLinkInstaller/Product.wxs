							<File Id="AvformatDll" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\avformat-61.dll" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="AvformatDll" Type="string" Value="1" KeyPath="yes" />
						</Component>

						<Component Id="AvutilDllComponent" Guid="97b835ca-2b64-4d45-9201-d86a3fdc4218" NeverOverwrite="yes" Permanent="yes">
							<File Id="AvutilDll" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\avutil-59.dll" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="AvutilDll" Type="string" Value="1" KeyPath="yes" />
						</Component>

						<Component Id="FfmpegExeComponent" Guid="05c5a85f-1d01-440b-9cd5-5b0e6fd57d62" NeverOverwrite="yes" Permanent="yes">
							<File Id="FfmpegExe" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\ffmpeg.exe" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
									   Name="FfmpegExe" Type="string" Value="1" KeyPath="yes" />
