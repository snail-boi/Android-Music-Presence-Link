							<File Id="ScrcpyServer" Source="..\Crimson AndroidMusicPresence\bin\Release\net8.0-windows10.0.19041.0\Resources\scrcpy-server" />
							<RegistryValue Root="HKCU" Key="Software\AndroidMusicPresenceLink\Resources"
