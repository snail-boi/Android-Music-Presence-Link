<UserControl x:Class="AndroidMusicPresenceLink.LyricsEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="LyrButton" TargetType="Button">
            <Setter Property="Background" Value="#5539cc"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#1A1A1A" CornerRadius="6" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="Lyrics" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock x:Name="LblStatus" HorizontalAlignment="Right" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
            </Grid>

            <TextBox x:Name="Txt" Grid.Row="1"
                     Background="#222222" Foreground="White" BorderBrush="#444444" CaretBrush="White"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" Padding="6,4"
                     TextChanged="Txt_TextChanged"/>

            <CheckBox x:Name="ChkLrc" Grid.Row="2" Content="Save .LRC in folder"
                      Foreground="#AAAAAA" Margin="0,8,0,0"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Style="{StaticResource LyrButton}" Background="#444444" Click="Cancel_Click"/>
                <Button Content="Clear" Style="{StaticResource LyrButton}" Background="#444444" Click="Clear_Click"/>
                <Button Content="Save" Style="{StaticResource LyrButton}" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
