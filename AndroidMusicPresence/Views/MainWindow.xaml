<Window x:Class="AndroidMusicPresenceLink.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AndroidMusicPresenceLink"
        mc:Ignorable="d"
        Title="Music Presence Settings" MinWidth="640" MinHeight="560" Width="720" Height="700"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:ColorStringToBrushConverter x:Key="HexToBrush" />

        <!-- ============ TYPOGRAPHY / TEXT ============ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="HeaderSubtitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ============ INPUTS ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0,0,0" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox style preserved (template + dropdown) -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Margin="8,0,28,0"
                                                      VerticalAlignment="Center" />
                                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                          Width="10" Height="6"
                                          Fill="{DynamicResource ThemeControlForegroundBrush}"
                                          Data="M 0 0 L 10 0 L 5 6 Z" />
                                </Grid>
                            </ToggleButton>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder"
                                        Background="{DynamicResource ThemeControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2">
                                    <ScrollViewer Margin="0" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Name="Bd" Background="{TemplateBinding Background}" Padding="2" CornerRadius="3">
                                        <ContentPresenter Margin="6,2" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ LISTBOX ============ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="false">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ BUTTONS ============ -->
        <!-- Default: primary (accent) button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPressedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary button: subtle, for less-important actions -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Theme category tab: segmented radio button (Default / Custom / Disabled) -->
        <Style x:Key="ThemeTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{DynamicResource ThemeControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="0,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentPressedBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact secondary button for theme-row actions and the pager -->
        <Style x:Key="ThemeRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- ============ CARD-STYLE EXPANDER ============ -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand"
                                              Focusable="False"
                                              OverridesDefaultStyle="True"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HBd" Background="Transparent" Padding="14,12" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                      VerticalAlignment="Center"
                                                                      TextBlock.FontWeight="SemiBold"
                                                                      TextBlock.FontSize="14"
                                                                      TextBlock.Foreground="{DynamicResource ThemeForegroundBrush}" />
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Width="10" Height="6"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource ThemeControlForegroundBrush}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HBd" Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="ContentSite"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Padding="14,4,14,14">
                                    <Border BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0">
                                        <ContentPresenter />
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel x:Name="RootContent">

        <!-- ============ STICKY HEADER ============ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ThemeControlBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AMPL" Style="{StaticResource HeaderTitleStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionInfoText}"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Opacity="0.7" 
                                   />
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Bottom"
                                   FontSize="11"
                                   Opacity="0.7" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CycleThemeCommand}"
                        Content="{Binding ActiveThemeName}"
                        MinWidth="120"
                        MaxWidth="200"
                        VerticalAlignment="Center"
                        ToolTip="Click to cycle through themes"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <!-- ============ STICKY FOOTER (SAVE BAR) ============ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource ThemeControlBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Changes are applied when you click Save."
                           Style="{StaticResource HintTextStyle}"
                           Margin="0"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Content="Save changes"
                        Command="{Binding SaveCommand}"
                        Width="140"
                        Height="36" />
            </Grid>
        </Border>

        <!-- ============ MAIN SCROLLABLE CONTENT ============ -->
        <Grid>
            <ScrollViewer x:Name="MainScrollViewer"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled"
                          ScrollChanged="MainScrollViewer_ScrollChanged">
                <StackPanel Margin="20,18,20,18" Orientation="Vertical">

                    <Border Margin="0,0,0,12">
                        <Button Content="Update"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Stretch"
                            Height="34"
                            Command="{Binding CheckUpdateCommand}" />
                    </Border>

                    <!-- ====== DEVICE CARD (open by default for new users) ====== -->
                    <Border CornerRadius="6"
                        Background="{DynamicResource ThemeControlBackgroundBrush}"
                        BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                        BorderThickness="1"
                        Padding="16"
                        Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Device" Style="{StaticResource SectionLabelStyle}" />
                                <TextBlock Text="Connect your Android phone via USB or Wi-Fi."
                                           Style="{StaticResource HintTextStyle}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Button Content="{Binding AutoOrPairButtonText}"
                                        Width="130"
                                        IsEnabled="{Binding IsNotBusy}"
                                        Command="{Binding AutoGatherOrPairCommand}" />
                                <Button Content="{Binding WifiModeButtonText}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="189"
                                        Margin="8,0,0,0"
                                        Command="{Binding WifiModeToggleCommand}" />
                                <Button Content="Reset"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="90"
                                        Margin="8,0,0,0"
                                        Command="{Binding ResetDeviceCommand}" />
                            </StackPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="USB serial"
                                       Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding UsbSerial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,0,8" />

                                <!-- TcpIp row: label + ip:port textbox. Hidden in WD mode. -->
                                <TextBlock Text="Wi-Fi (ip:port)"
                                       Grid.Row="1" Grid.Column="0"
                                       Visibility="{Binding WifiAddressVisible, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding WifiAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="1" Grid.Column="1"
                                     Visibility="{Binding WifiAddressVisible, Converter={StaticResource BoolToVis}}"
                                     Margin="0,0,0,8" />

                                <!-- mDNS row: read-only display, only shown when paired in WD mode. -->
                                <TextBlock Text="mDNS service"
                                       Grid.Row="2" Grid.Column="0"
                                       Visibility="{Binding MdnsVisible, Converter={StaticResource BoolToVis}}"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding MdnsService}"
                                     Grid.Row="2" Grid.Column="1"
                                     Visibility="{Binding MdnsVisible, Converter={StaticResource BoolToVis}}"
                                     IsReadOnly="True"
                                     Margin="0,0,0,8" />

                                <TextBlock Text="Device name"
                                       Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding DeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="3" Grid.Column="1" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ====== POLLING ====== -->
                    <Expander Header="Polling" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <CheckBox Content="Adaptive polling (battery saver)"
                                      IsChecked="{Binding AdaptivePollingEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,4"
                                      Style="{StaticResource ToggleSwitchStyle}" />

                            <Grid Margin="0,0,0,4"
                                  Visibility="{Binding AdaptivePollingEnabled, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Inactivity threshold (min)"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding AdaptivePollingThresholdText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                            </Grid>

                            <CheckBox Content="Alert when poll rate drops"
                                      IsChecked="{Binding AdaptivePollingAlertEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,4"
                                      Visibility="{Binding AdaptivePollingEnabled, Converter={StaticResource BoolToVis}}"
                                      Style="{StaticResource ToggleSwitchStyle}" />

                            <TextBlock Text="Slows the poll rate after a few minutes of inactivity and snaps back when you interact. Song changes, cover art, and the position bar may lag until you interact while it's slowed."
                                   Visibility="{Binding AdaptivePollingEnabled, Converter={StaticResource BoolToVis}}"
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,8" />

                            <Grid Margin="0,0,0,8"
                                  Visibility="{Binding IntervalDropdownVisible, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Update interval"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding UpdateIntervalIndex, Mode=TwoWay}">
                                    <ComboBoxItem>1 sec</ComboBoxItem>
                                    <ComboBoxItem>3 sec</ComboBoxItem>
                                    <ComboBoxItem>5 sec</ComboBoxItem>
                                    <ComboBoxItem>10 sec</ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <TextBlock Visibility="{Binding IntervalWarningVisible, Converter={StaticResource BoolToVis}}"
                                   Text="{Binding IntervalWarningText}"
                                   Style="{StaticResource HintTextStyle}"
                                   Foreground="#E6A020"
                                   Margin="0,0,0,8" />
                        </StackPanel>
                    </Expander>

                    <!-- ====== FOLDERS & CACHE ====== -->
                    <Expander x:Name="LibraryCachingExpander" Header="Library &amp; Caching" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Library"
                                   Style="{StaticResource HeaderTitleStyle}" />
                            <Separator/>
                            <TextBlock Text="Tell the app where to find your music and lyrics on the device."
                                   Style="{StaticResource HintTextStyle}" />

                            <TextBlock Text="Music remote folders"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,4,0,6" />
                            <ListBox ItemsSource="{Binding RemoteRoots}"
                                 Height="130"
                                 Margin="0,0,0,8"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                   Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding}" />
                                            <Button Grid.Column="1"
                                                Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="90"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.RemoveRemoteRootCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="Add folder" Width="120" Command="{Binding PickRemoteRootCommand}" />
                            </StackPanel>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Lyrics folder (phone)"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding LyricsFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1" />
                                <Button Grid.Column="2"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    Command="{Binding BrowseLyricsCommand}" />
                            </Grid>
                            
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cover filename patterns"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CoverPatterns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1"
                                     ToolTip="Semicolon separated, e.g. cover.jpg;folder.jpg;front.png" />
                            </Grid>

                            <!-- Caching -->

                            <TextBlock Text="Caching"
                                   Style="{StaticResource HeaderTitleStyle}" />
                            <Separator/>
                            <TextBlock Text="Album art and embedded lyrics are cached locally so they load faster."
                                   Style="{StaticResource HintTextStyle}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Clear cache after"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CacheClearText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" />
                                <TextBlock Text="MB"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cached cover quality"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                      SelectedIndex="{Binding CoverQualityIndex, Mode=TwoWay}">
                                    <ComboBoxItem>Max (original size)</ComboBoxItem>
                                    <ComboBoxItem>High (1024 px)</ComboBoxItem>
                                    <ComboBoxItem>Medium (512 px)</ComboBoxItem>
                                    <ComboBoxItem>Low (256 px)</ComboBoxItem>
                                    <ComboBoxItem>Tiny (128 px)</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Covers cached from now on are downscaled to this size so the cache holds more art. Only affects new covers; clear the cache to re-fetch existing ones."
                                   Style="{StaticResource HintTextStyle}"
                                   Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Clear cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="135"
                                    Command="{Binding ClearCoverCacheCommand}" />
                                <Button Content="Open cover cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="135"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenCoverCacheCommand}" />
                                <Button Content="Open lyrics cache"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="135"
                                    Margin="8,0,0,0"
                                    Command="{Binding OpenLyricsCacheCommand}" />
                            </StackPanel>

                            <!-- Custom (forced) covers -->

                            <TextBlock Text="Custom covers"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Margin="0,16,0,4" />
                            <TextBlock Text="Covers you've set via right-click on the cover art in the media player. Remove one to go back to the real cover art."
                                   Style="{StaticResource HintTextStyle}" />

                            <ItemsControl ItemsSource="{Binding ForcedCovers}" Margin="0,4,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="120" Margin="0,0,10,10">
                                            <Image Source="{Binding Thumbnail}"
                                               Width="96" Height="96"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Title}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   ToolTip="{Binding Title}"
                                                   Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Artist}"
                                                   Style="{StaticResource HintTextStyle}"
                                                   TextTrimming="CharacterEllipsis"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   ToolTip="{Binding Artist}"
                                                   Margin="0,0,0,0" />
                                            <Button Content="Remove"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Width="90"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                Command="{Binding DataContext.RemoveForcedCoverCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="Remove all custom covers"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180"
                                HorizontalAlignment="Left"
                                Command="{Binding RemoveAllForcedCoversCommand}"
                                IsEnabled="{Binding HasForcedCovers}" />
                        </StackPanel>
                    </Expander>

                    <!-- ====== SUBSONIC ====== -->
                    <Expander Header="Subsonic" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Cover art and duration fallback for streamed tracks (Subsonic-compatible servers: Navidrome, Airsonic, etc.). Used per-app via the Subsonic toggle in the Apps list. The PC must be able to reach the server directly (same LAN or Tailscale)."
                                   Style="{StaticResource HintTextStyle}" />

                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Server URL"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SubsonicServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1"
                                     ToolTip="e.g. http://192.168.1.50:4533" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Username"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding SubsonicUsername, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1" />
                            </Grid>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Password"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <PasswordBox x:Name="SubsonicPasswordBox"
                                     Grid.Column="1"
                                     PasswordChanged="SubsonicPasswordBox_PasswordChanged" />
                            </Grid>
                            <TextBlock Text="Stored encrypted on this PC only (Windows DPAPI); never written to musicconfig.json in plain text."
                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Test connection"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="135"
                                    Command="{Binding TestSubsonicConnectionCommand}" />
                                <TextBlock Text="{Binding SubsonicTestResultText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource HintTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- ====== ELIGIBLE APPS ====== -->
                    <Expander Header="Apps" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Saved apps and their current settings. Use Manage apps to add or configure."
                                   Style="{StaticResource HintTextStyle}" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Manage apps"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"
                                    Command="{Binding ManageAppsCommand}" />
                                <Button Content="Clear all disabled"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"
                                    Margin="8,0,0,0"
                                    Command="{Binding ClearDisabledAppsCommand}" />
                            </StackPanel>

                            <Grid Margin="6,0,6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="125" />
                                    <ColumnDefinition Width="55" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="App" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Grid.Column="1" Text="Presence" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="Cover" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="Subsonic" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" />
                            </Grid>
                            <ListBox ItemsSource="{Binding AppPackages}"
                                 Height="200"
                                 Margin="0,0,0,0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="4,2,4,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="4"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PackageName}" />

                                            <Button Grid.Column="1"
                                                    Content="{Binding PresenceModeLabel}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="68" Height="27"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Background="{Binding PresenceModeBrush}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.CyclePresenceModeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Grid.Column="2"
                                                    Content="{Binding CoverLabel}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="45" Height="27"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Background="{Binding CoverBrush}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleCoverCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>

                                            <Button Grid.Column="3"
                                                    Content="{Binding SubsonicLabel}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="55" Height="27"
                                                    FontSize="11" FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Background="{Binding SubsonicBrush}"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    ToolTip="Query the configured Subsonic server for cover art and duration. Combine with Cover to fall back only when no local file matches."
                                                    Command="{Binding DataContext.ToggleSubsonicCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Expander>

                    <!-- ====== HOTKEYS ====== -->
                    <Expander Header="Hotkeys" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Click Record, then hold the key combination you want (up to 5 keys, e.g. CTRL+ALT+C) and release to save. Press Esc while recording to disable a hotkey."
                                   Style="{StaticResource HintTextStyle}" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Volume up"
                                       Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding VolumeUpHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding VolumeUpHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="0" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding VolumeUpHotkey.RecordCommand}"
                                    Visibility="{Binding VolumeUpHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding VolumeUpHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding VolumeUpHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding VolumeUpHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding VolumeUpHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Volume down"
                                       Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding VolumeDownHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding VolumeDownHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="1" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding VolumeDownHotkey.RecordCommand}"
                                    Visibility="{Binding VolumeDownHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding VolumeDownHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding VolumeDownHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding VolumeDownHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding VolumeDownHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Toggle audio link"
                                       Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding ToggleScrcpyHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="2" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding ToggleScrcpyHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="2" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding ToggleScrcpyHotkey.RecordCommand}"
                                    Visibility="{Binding ToggleScrcpyHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding ToggleScrcpyHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleScrcpyHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleScrcpyHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding ToggleScrcpyHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Toggle lyrics"
                                       Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding ToggleLyricsOverlayHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="3" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding ToggleLyricsOverlayHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="3" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding ToggleLyricsOverlayHotkey.RecordCommand}"
                                    Visibility="{Binding ToggleLyricsOverlayHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding ToggleLyricsOverlayHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleLyricsOverlayHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding ToggleLyricsOverlayHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding ToggleLyricsOverlayHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Copy track info"
                                       Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding CopyTrackInfoHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="4" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding CopyTrackInfoHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="4" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding CopyTrackInfoHotkey.RecordCommand}"
                                    Visibility="{Binding CopyTrackInfoHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding CopyTrackInfoHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CopyTrackInfoHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding CopyTrackInfoHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding CopyTrackInfoHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Audio quality"
                                       Grid.Row="5" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding AudioQualityHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="5" Grid.Column="1"
                                     Visibility="{Binding AudioQualityHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="5" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    Command="{Binding AudioQualityHotkey.RecordCommand}"
                                    Visibility="{Binding AudioQualityHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                                       Visibility="{Binding AudioQualityHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AudioQualityHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AudioQualityHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding AudioQualityHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>

                            <Separator/>
                            <CheckBox Content="Custom media keys (Direct mode)"
                                      IsChecked="{Binding MediaKeysDirectMode, Mode=TwoWay}"
                                      Margin="0,8,0,4"
                                      Style="{StaticResource ToggleSwitchStyle}" />
                            <TextBlock Text="Play/pause and next/previous are normally handled by Windows when your keyboard has media keys (SMTC mode). Enable this to bind your own keys instead - handy when your keyboard has no media keys. In Direct mode these send the command straight to the phone."
                                   Style="{StaticResource HintTextStyle}" />

                            <Grid Margin="0,4,0,0"
                                  Visibility="{Binding MediaKeysDirectMode, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Play / pause"
                                       Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding PlayPauseHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="0" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding PlayPauseHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="0" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding PlayPauseHotkey.RecordCommand}"
                                    Visibility="{Binding PlayPauseHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding PlayPauseHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PlayPauseHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PlayPauseHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding PlayPauseHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Next track"
                                       Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding NextTrackHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="1" Grid.Column="1"
                                     Margin="0,0,0,6"
                                     Visibility="{Binding NextTrackHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="1" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,6"
                                    Command="{Binding NextTrackHotkey.RecordCommand}"
                                    Visibility="{Binding NextTrackHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,6"
                                       Visibility="{Binding NextTrackHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding NextTrackHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding NextTrackHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding NextTrackHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>

                                <TextBlock Text="Previous track"
                                       Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox IsReadOnly="True" Text="{Binding PreviousTrackHotkey.Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Row="2" Grid.Column="1"
                                     Visibility="{Binding PreviousTrackHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <Button Grid.Row="2" Grid.Column="2"
                                    Content="Record"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="90"
                                    Margin="8,0,0,0"
                                    Command="{Binding PreviousTrackHotkey.RecordCommand}"
                                    Visibility="{Binding PreviousTrackHotkey.IsEditorVisible, Converter={StaticResource BoolToVis}}" />
                                <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                       Visibility="{Binding PreviousTrackHotkey.IsConfirming, Converter={StaticResource BoolToVis}}">
                                    <Button DockPanel.Dock="Right" Content="No" Width="50" Margin="4,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PreviousTrackHotkey.ConfirmNoCommand}" />
                                    <Button DockPanel.Dock="Right" Content="Yes" Width="50" Margin="8,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding PreviousTrackHotkey.ConfirmYesCommand}" />
                                    <TextBlock Text="{Binding PreviousTrackHotkey.ConfirmationMessage}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                            </Grid>

                            <Separator/>
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Copy template"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding CopyTrackTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Grid.Column="1"
                                     ToolTip="Use {artist}, {title}, {album}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- ====== AUDIO Q&L ====== -->
                    <Expander Header="Audio Quality &amp; Link" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Quality"
                                   Style="{StaticResource HeaderTitleStyle}" />
                            <Separator/>
                            <TextBlock Text="Quality settings used when streaming audio from your phone."
                                   Style="{StaticResource HintTextStyle}" />

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Quality preset"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding QualityPresets}"
                                      SelectedItem="{Binding SelectedQualityPreset, Mode=TwoWay}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="List codecs"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"
                                    Command="{Binding ListCodecsCommand}" />
                                <TextBlock Text="{Binding CodecStatus}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center" />
                            </StackPanel>

                            <ListBox ItemsSource="{Binding AudioCodecs}"
                                 SelectedItem="{Binding SelectedCodec, Mode=TwoWay}"
                                 Height="120"
                                 Margin="0,0,0,12"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />

                            <Grid Visibility="{Binding ShowBitratePanel, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bitrate"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding AudioBitrate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" />
                                <TextBlock Text="kbps"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" />
                            </Grid>

                            <Grid x:Name="PanelAudioBuffer" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Audio buffer"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding AudioBuffer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" />
                                <TextBlock Text="ms"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" />
                            </Grid>

                            <Grid Visibility="{Binding ShowFlacPanel, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="FLAC level"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding FlacCompressionLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" />
                            </Grid>

                            <TextBlock Text="Link"
                                   Style="{StaticResource HeaderTitleStyle}" />
                            <Separator/>
                            <!-- Audio link behaviour -->
                            <TextBlock Text="Audio link"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,4" />
                            <CheckBox Content="Auto-restart on connection change"
                                      IsChecked="{Binding AudioLinkConnectionAutoRestart, Mode=TwoWay}"
                                      Margin="0,0,0,4"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="Automatically restarts audio link when the connection transport changes (USB to Wi-Fi or vice versa), or when scrcpy exits unexpectedly." />
                            <TextBlock Text="Audio link will not switch transports. Audio may keep routing over Wi-Fi even after USB is plugged in."
                                       Style="{StaticResource HintTextStyle}"
                                       Foreground="#E6A020"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding AudioLinkConnectionAutoRestartWarningVisible, Converter={StaticResource BoolToVis}}" />
                            <CheckBox Content="Auto-restart on quality change"
                                      IsChecked="{Binding AudioLinkQualityAutoRestart, Mode=TwoWay}"
                                      Margin="0,0,0,4"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="Automatically restarts audio link when the audio quality preset is changed." />
                            <TextBlock Text="Quality changes will not take effect until audio link is manually restarted."
                                       Style="{StaticResource HintTextStyle}"
                                       Foreground="#E6A020"
                                       Margin="0,0,0,4"
                                       Visibility="{Binding AudioLinkQualityAutoRestartWarningVisible, Converter={StaticResource BoolToVis}}" />
                            <CheckBox Content="Bleedless restarts"
                                      IsChecked="{Binding AudioLinkBleedless, Mode=TwoWay}"
                                      Margin="0,0,0,12"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="Mutes the device before stopping audio link and resumes playback after it restarts. Disable if mute/unmute interferes with your player." />
                        </StackPanel>
                    </Expander>

                    <!-- ====== THEMING ====== -->
                    <Expander Header="Theming" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Click a theme to apply it. Default holds the built-in themes, Custom holds yours, and Disabled holds themes skipped by cycling and the random-at-startup pick. Don't forget to save."
                                       Style="{StaticResource HintTextStyle}" />

                            <!-- ── Category tabs ── -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Default" GroupName="ThemeTabs" Margin="0,0,4,0"
                                             Style="{StaticResource ThemeTabStyle}"
                                             IsChecked="{Binding IsDefaultThemeTab, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1" Content="Custom" GroupName="ThemeTabs" Margin="4,0"
                                             Style="{StaticResource ThemeTabStyle}"
                                             IsChecked="{Binding IsCustomThemeTab, Mode=TwoWay}" />
                                <RadioButton Grid.Column="2" Content="Disabled" GroupName="ThemeTabs" Margin="4,0,0,0"
                                             Style="{StaticResource ThemeTabStyle}"
                                             IsChecked="{Binding IsDisabledThemeTab, Mode=TwoWay}" />
                            </Grid>

                            <!-- ── Paged theme list (5 per page) ── -->
                            <ItemsControl ItemsSource="{Binding ThemePageItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,0,6" Focusable="False"
                                                Command="{Binding DataContext.SelectThemeItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd"
                                                            Background="{DynamicResource ThemeBackgroundBrush}"
                                                            BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="10,7"
                                                            Cursor="Hand">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Swatch: background chip with accent + text dots -->
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" Margin="0,0,10,0"
                                                                    Background="{Binding Background, Converter={StaticResource HexToBrush}}"
                                                                    BorderBrush="#40808080" BorderThickness="1">
                                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Ellipse Width="9" Height="9" Margin="0,0,3,0"
                                                                             Fill="{Binding Accent, Converter={StaticResource HexToBrush}}" />
                                                                    <Ellipse Width="9" Height="9"
                                                                             Fill="{Binding Foreground, Converter={StaticResource HexToBrush}}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource ThemeForegroundBrush}" />

                                                            <!-- Active-theme check -->
                                                            <Path x:Name="Check" Grid.Column="2" Width="14" Height="11" Margin="6,0,10,0"
                                                                  VerticalAlignment="Center" Stretch="Uniform" Visibility="Collapsed"
                                                                  Fill="{DynamicResource ThemeAccentBrush}"
                                                                  Data="M 0 5 L 5 10 L 14 0 L 12 -1 L 5 7 L 2 4 Z" />

                                                            <!-- Row actions -->
                                                            <StackPanel x:Name="Actions" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button x:Name="EditBtn" Content="Edit" Margin="0,0,6,0"
                                                                        Style="{StaticResource ThemeRowButtonStyle}"
                                                                        ToolTip="Edit this theme's name and colors"
                                                                        Command="{Binding DataContext.ToggleEditThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button x:Name="RemoveBtn" Content="Remove" Margin="0,0,6,0"
                                                                        Style="{StaticResource ThemeRowButtonStyle}"
                                                                        Command="{Binding DataContext.RequestRemoveThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button x:Name="DisableBtn" Content="Disable"
                                                                        Style="{StaticResource ThemeRowButtonStyle}"
                                                                        ToolTip="Disabled themes are skipped by cycling and the random-at-startup pick"
                                                                        Command="{Binding DataContext.ToggleThemeDisabledCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>

                                                            <!-- Remove confirm state -->
                                                            <StackPanel x:Name="ConfirmActions" Grid.Column="3" Orientation="Horizontal"
                                                                        VerticalAlignment="Center" Visibility="Collapsed">
                                                                <TextBlock Text="Are you sure?" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                                           Foreground="{DynamicResource ThemeForegroundBrush}" />
                                                                <Button Content="Yes" Margin="0,0,6,0"
                                                                        Style="{StaticResource ThemeRowButtonStyle}"
                                                                        Command="{Binding DataContext.ConfirmRemoveThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                                <Button Content="No"
                                                                        Style="{StaticResource ThemeRowButtonStyle}"
                                                                        Command="{Binding DataContext.CancelRemoveThemeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeForegroundBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActiveTheme}" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                                            <Setter TargetName="Bd" Property="Padding" Value="9,6" />
                                                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                            <Setter TargetName="EditBtn" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="RemoveBtn" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter TargetName="DisableBtn" Property="Content" Value="Enable" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                            <Setter TargetName="EditBtn" Property="Content" Value="Save" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsConfirmingRemove}" Value="True">
                                                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="ConfirmActions" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding ThemePageEmptyHint}"
                                       Style="{StaticResource HintTextStyle}"
                                       Visibility="{Binding ThemePageEmpty, Converter={StaticResource BoolToVis}}" />

                            <!-- ── Pager + New theme ── -->
                            <Grid Margin="0,2,0,10">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                            Visibility="{Binding ThemePagerVisible, Converter={StaticResource BoolToVis}}">
                                    <Button Content="Prev" Width="52"
                                            Style="{StaticResource ThemeRowButtonStyle}"
                                            IsEnabled="{Binding CanPrevThemePage}"
                                            Command="{Binding PrevThemePageCommand}" />
                                    <TextBlock Text="{Binding ThemePageLabel}" FontSize="11" VerticalAlignment="Center" Margin="10,0" />
                                    <Button Content="Next" Width="52"
                                            Style="{StaticResource ThemeRowButtonStyle}"
                                            IsEnabled="{Binding CanNextThemePage}"
                                            Command="{Binding NextThemePageCommand}" />
                                </StackPanel>
                                <Button Content="New theme" Width="90" HorizontalAlignment="Right"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding AddThemeCommand}" />
                            </Grid>

                            <TextBlock Text="This is a built-in theme. Press New theme to create an editable copy."
                                       Style="{StaticResource HintTextStyle}"
                                       Visibility="{Binding IsBuiltInSelected, Converter={StaticResource BoolToVis}}" />

                            <!-- ── Editor (opened by a row's Edit button, closed by Save) ── -->
                            <Border Background="{DynamicResource ThemeBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10"
                                    Visibility="{Binding IsThemeEditorOpen, Converter={StaticResource BoolToVis}}">
                              <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" MaxLength="30"
                                             Text="{Binding SelectedThemeName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource ThemeControlBorderBrush}" BorderThickness="1"
                                            Background="{Binding SelectedTheme.Background, Converter={StaticResource HexToBrush}}" />
                                    <TextBox Grid.Column="2" Margin="0,0,8,0"
                                             Text="{Binding SelectedTheme.Background, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Content="Pick" Width="64"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding PickBackgroundCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Buttons / accent" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource ThemeControlBorderBrush}" BorderThickness="1"
                                            Background="{Binding SelectedTheme.Accent, Converter={StaticResource HexToBrush}}" />
                                    <TextBox Grid.Column="2" Margin="0,0,8,0"
                                             Text="{Binding SelectedTheme.Accent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Content="Pick" Width="64"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding PickAccentCommand}" />
                                </Grid>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Text" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Margin="0,0,8,0"
                                            BorderBrush="{DynamicResource ThemeControlBorderBrush}" BorderThickness="1"
                                            Background="{Binding SelectedTheme.Foreground, Converter={StaticResource HexToBrush}}" />
                                    <TextBox Grid.Column="2" Margin="0,0,8,0"
                                             Text="{Binding SelectedTheme.Foreground, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Content="Pick" Width="64"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding PickForegroundCommand}" />
                                </Grid>
                              </StackPanel>
                            </Border>

                            <CheckBox Content="Pick a random theme at startup"
                                      IsChecked="{Binding RandomThemeAtStartup, Mode=TwoWay}"
                                      Margin="0,12,0,0"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="On each launch, a random in-rotation theme is chosen and applied." />
                        </StackPanel>
                    </Expander>

                    <!-- ====== STARTUP ====== -->
                    <Expander Header="Startup" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <Button Content="{Binding MediaPlayerViewButtonText}"
                                     Style="{StaticResource SecondaryButtonStyle}"
                                     Width="200"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,12"
                                     Command="{Binding ToggleMediaPlayerViewCommand}" />

                            <CheckBox Content="Start minimized to tray" IsChecked="{Binding OpenInTaskbar, Mode=TwoWay}" Margin="0,0,0,8" Style="{StaticResource ToggleSwitchStyle}"/>
                            <CheckBox Content="Start when Windows starts" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" Margin="0,0,0,12" Style="{StaticResource ToggleSwitchStyle}"/>
                        </StackPanel>
                    </Expander>

                    <!-- ====== POPUPS & TOASTS ====== -->
                    <Expander Header="Popups/toasts" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="how and where popups may appear"
                            Style="{StaticResource HintTextStyle}" />
                            <!-- Notification toasts -->

                            <CheckBox Content="Show headless popups"
                                      IsChecked="{Binding HeadlessToastEnabled, Mode=TwoWay}"
                                      Margin="0,0,0,8"
                                      Style="{StaticResource ToggleSwitchStyle}" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Headless popup position"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <Button Grid.Column="1"
                                        Content="{Binding HeadlessToastPositionLabel}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="140"
                                        Command="{Binding CycleHeadlessPositionCommand}" />
                            </Grid>



                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Media player popups"
                                           Grid.Column="0"
                                           Style="{StaticResource FieldLabelStyle}" />
                                <Button Grid.Column="1"
                                        Content="{Binding MediaPlayerToastModeLabel}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="140"
                                        Opacity="{Binding MediaPlayerToastModeOpacity}"
                                        Command="{Binding CycleMediaPlayerToastModeCommand}" />
                            </Grid>


                        </StackPanel>
                    </Expander>

                    <!-- ====== OTHER ====== -->
                    <Expander Header="Other" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="miscellaneous options."
                                Style="{StaticResource HintTextStyle}" />
                            


                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="SMTC paused clear delay"
                                       Grid.Column="0"
                                       Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding PauseClearDelayText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" />
                                <TextBlock Text="min (0 = off)"
                                       Grid.Column="2"
                                       Margin="8,0,0,0"
                                       Style="{StaticResource FieldLabelStyle}" />
                            </Grid>

                            <!-- No-cover icon -->
                            <TextBlock Text="No-cover icon"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Shown in the media player when no cover art is found. Leave empty to show nothing."
                                       Style="{StaticResource HintTextStyle}" />
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NoCoverIconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True"
                                         Margin="0,0,6,0" />
                                <Button Grid.Column="1"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="72"
                                        Margin="0,0,6,0"
                                        Command="{Binding BrowseNoCoverIconCommand}" />
                                <Button Grid.Column="2"
                                        Content="Clear"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="60"
                                        Command="{Binding ClearNoCoverIconCommand}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- ====== DEBUG ====== -->
                    <Expander Header="Debug/Advanced" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded" Collapsed="Expander_Collapsed">
                        <StackPanel>
                            <TextBlock Text="Advanced behavior, startup, and miscellaneous options."
                                   Style="{StaticResource HintTextStyle}" />

                            <CheckBox Content="Enable debug logging" IsChecked="{Binding DebugMode, Mode=TwoWay}" Margin="0,0,0,8" Style="{StaticResource ToggleSwitchStyle}"/>
                            <CheckBox Content="Advanced debug logging"
                                      IsChecked="{Binding AdvancedDebugMode, Mode=TwoWay}"
                                      Margin="16,0,0,4"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      ToolTip="Traces every ADB command and its output to a single advanced_debug.log. Replaces normal logging while enabled."/>
                            <TextBlock Text="Logs all ADB traffic to advanced_debug.log; normal logging pauses while this is on."
                                       Style="{StaticResource HintTextStyle}"
                                       Margin="16,0,0,8"/>
                            <Button Content="Open log folder"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="160"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Command="{Binding OpenLogFolderCommand}" />

                            <!-- Config import / export -->
                            <TextBlock Text="Configuration"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Export all settings to a file, or import a previously exported configuration. Importing replaces your current settings."
                                       Style="{StaticResource HintTextStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Content="Export config"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="160"
                                    Command="{Binding ExportConfigCommand}" />
                                <Button Content="Import config"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="160"
                                    Margin="8,0,0,0"
                                    Command="{Binding ImportConfigCommand}" />
                            </StackPanel>

                            <!-- Custom binary paths -->
                            <TextBlock Text="Custom binaries"
                                       Style="{StaticResource FieldLabelStyle}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Override the bundled ADB, scrcpy, and ffmpeg. Leave as-is to use the bundled versions."
                                       Style="{StaticResource HintTextStyle}" />

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ADB" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding CustomAdbPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True"
                                         Margin="0,0,6,0" />
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="72"
                                        Command="{Binding BrowseAdbCommand}" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ffmpeg" Grid.Column="0" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding CustomFfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="True"
                                         Margin="0,0,6,0" />
                                <Button Grid.Column="2"
                                        Content="Browse"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="72"
                                        Command="{Binding BrowseFfmpegCommand}" />
                            </Grid>

                            <Button Content="Reset to bundled binaries"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    Command="{Binding ResetBinaryPathsCommand}" />

                            <CheckBox Content="Use dark mode" IsChecked="{Binding UseDarkMode, Mode=TwoWay}" VerticalAlignment="Center" Visibility="Collapsed" />

                            <Button Content="Run onboarding again"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="200"
                                HorizontalAlignment="Left"
                                Command="{Binding RedoOnboardingCommand}" />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

            <!-- Scroll-more indicator: a chevron that fades out when scrolled to the bottom -->
            <Border x:Name="ScrollIndicator"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Height="48"
                    IsHitTestVisible="False"
                    Opacity="1"
                    Background="Transparent">
                <Path x:Name="ScrollIndicatorChevron"
                      Data="M 0,0 L 10,8 L 20,0"
                      Stroke="{DynamicResource ThemeForegroundBrush}"
                      StrokeThickness="2"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Bottom"
                      Margin="0,0,0,8"
                      Opacity="0.5" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
