<Window x:Class="AndroidMusicPresenceLink.RemoteFolderPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Remote Folder"
        Width="560" Height="520"
        MinWidth="400" MinHeight="340"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>

        <PathGeometry x:Key="FolderIconData"
            Figures="M 1,3 L 1,13 L 15,13 L 15,5 L 7,5 L 5.5,3 Z" />

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            TreeViewItem: use the default expand mechanism (no Template replacement).
            Only set visual properties and the two-way VM bindings via setters.
            The default WPF TreeViewItem expander arrow and click-to-expand behavior
            are left entirely intact.
        -->
        <Style x:Key="FolderTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground"  Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="Padding"     Value="3,3,6,3" />
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="{StaticResource FolderIconData}"
                      Fill="{DynamicResource ThemeAccentBrush}"
                      Width="20" Height="18"
                      Stretch="Uniform"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="Select Remote Folder"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource ThemeForegroundBrush}" />
                    <TextBlock Text="Browse your phone's storage, or type a path in the box below"
                               FontSize="11"
                               Opacity="0.6"
                               Foreground="{DynamicResource ThemeForegroundBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Tree -->
        <TreeView x:Name="FolderTree"
                  Grid.Row="1"
                  Margin="8,8,8,0"
                  Background="{DynamicResource ThemeControlBackgroundBrush}"
                  BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                  BorderThickness="1"
                  Padding="4"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ItemsSource="{Binding Roots}"
                  ItemContainerStyle="{StaticResource FolderTreeItemStyle}"
                  SelectedItemChanged="FolderTree_SelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource FolderIconData}"
                              Fill="{DynamicResource ThemeAccentBrush}"
                              Width="14" Height="12"
                              Stretch="Uniform"
                              VerticalAlignment="Center"
                              Margin="0,0,5,0"
                              Opacity="0.85" />
                        <TextBlock Text="{Binding Name}"
                                   Foreground="{DynamicResource ThemeForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Path bar -->
        <Border Grid.Row="2"
                Margin="8,6,8,0"
                Background="{DynamicResource ThemeControlBackgroundBrush}"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Path: "
                           FontSize="12"
                           FontWeight="SemiBold"
                           Opacity="0.55"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundBrush}" />
                <TextBox x:Name="PathBox"
                         Grid.Column="1"
                         FontSize="12"
                         FontFamily="Consolas, Courier New, monospace"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0,8,0,8"
                         Foreground="{DynamicResource ThemeControlForegroundBrush}"
                         CaretBrush="{DynamicResource ThemeControlForegroundBrush}"
                         VerticalContentAlignment="Center"
                         ToolTip="Type or paste a path, then click Select Folder"
                         TextChanged="PathBox_TextChanged" />
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="OkButton"
                        Content="Select Folder"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding OkCommand}" />
            </StackPanel>
        </Border>

    </Grid>
</Window>
