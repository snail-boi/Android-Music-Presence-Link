<Window x:Class="AndroidMusicPresenceLink.MetadataEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit metadata" Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5539cc"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cover preview and actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="6" Background="#22000000" ClipToBounds="True">
                <Image x:Name="ImgCoverPreview" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <TextBlock Text="{Binding FileLabel}" Foreground="#888888" FontSize="11"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Change cover..." Command="{Binding ChangeCoverCommand}" Margin="0"/>
                    <Button Content="Remove" Command="{Binding RemoveCoverCommand}" Background="#444444"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Artist" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Album" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Album artist" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Composer" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Track number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Disc number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Comment" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox Content="Keep original date modified" Foreground="#AAAAAA"
                      IsChecked="{Binding RetainDate}" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Background="#444444"/>
                <Button Content="Save" Command="{Binding OkCommand}" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
