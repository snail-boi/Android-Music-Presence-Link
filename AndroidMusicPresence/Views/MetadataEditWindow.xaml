<Window x:Class="AndroidMusicPresenceLink.MetadataEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AndroidMusicPresenceLink"
        Title="Edit metadata" Height="640" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ThemeBackgroundBrush}"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeControlForegroundBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary (accent) button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPressedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary (outlined) button -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cover preview and actions -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="6"
                    Background="{DynamicResource ThemeControlBorderBrush}" ClipToBounds="True">
                <Image x:Name="ImgCoverPreview" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                <TextBlock Text="{Binding FileLabel}"
                           Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.55"
                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Change cover..." Command="{Binding ChangeCoverCommand}" Margin="0"/>
                    <Button Content="Remove" Command="{Binding RemoveCoverCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="BtnLyrics" Content="{Binding LyricsButtonLabel}" Click="BtnLyrics_Click" Margin="0"/>
                    <TextBlock Text="{Binding LyricsStatus}"
                               Foreground="{DynamicResource ThemeForegroundBrush}" Opacity="0.55"
                               FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Artist" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Album" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Album, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Album artist" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding AlbumArtist, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Composer" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Composer, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Genre" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Track number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding TrackNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Disc number" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FieldBox}" Text="{Binding DiscNumber, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Year" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Year, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Comment" Style="{StaticResource FieldLabel}"/>
                <TextBox Style="{StaticResource FieldBox}" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48"/>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="LyricsHost" Grid.Row="2" Visibility="Collapsed" Margin="0,8,0,0" Height="240">
            <local:LyricsEditorControl x:Name="LyricsEditor"/>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <CheckBox Content="Keep original date modified"
                      IsChecked="{Binding RetainDate}"
                      Style="{StaticResource ToggleSwitchStyle}"
                      Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Save" Command="{Binding OkCommand}"
                        IsDefault="True" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
