<Window x:Class="AndroidMusicPresenceLink.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Player"
        Width="1080"
        Height="760"
        MinWidth="500"
        MinHeight="620"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style x:Key="PaneToggleArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Opacity="0.75">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pill-shaped small button style for connection info / audio link -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom rounded slider for the progress bar -->
        <Style x:Key="RoundedProgressSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- Track background, full width, rounded -->
                            <Border Height="4"
                                    Width="400"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center" />
                            <!-- Track containing fill + thumb -->
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False"
                                                  IsTabStop="False"
                                                  Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        CornerRadius="2"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False"
                                                  IsTabStop="False"
                                                  Command="Slider.IncreaseLarge"
                                                  Background="Transparent"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14"
                                                         Height="14"
                                                         Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rounded slider style for volume popup (matches RoundedProgressSliderStyle) -->
        <Style x:Key="RoundedVolumeSliderStyle" TargetType="Slider">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{TemplateBinding Background}"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False" Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="White"
                                                        VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" IsTabStop="False" Command="Slider.IncreaseLarge" Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14"
                                                         Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="0" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterColumn" Width="0" MinWidth="0" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition x:Name="PlayerSettingsSplitterColumn" Width="0" MinWidth="0" />
            <ColumnDefinition x:Name="PlayerSettingsColumn" Width="0" MinWidth="0" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SettingsPaneBorder"
                Grid.Column="0"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed"
                Background="{DynamicResource ThemeControlBackgroundBrush}">
            <ContentControl x:Name="SettingsHost" />
        </Border>

        <Border x:Name="PlayerSettingsPaneBorder"
                Grid.Column="4"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Visibility="Collapsed"
                Background="{DynamicResource ThemeControlBackgroundBrush}">
            <ContentControl x:Name="PlayerSettingsHost" />
        </Border>

        <Border x:Name="PlayerPaneBorder"
                Grid.Column="2"
                Grid.ColumnSpan="1"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="24,28,24,28"
                ClipToBounds="True">
            <Grid>
                <!-- Animated gradient background, two stacked rectangles for crossfade.
                     Negative margin cancels the parent Border's Padding so the gradient
                     fills edge-to-edge and is clipped by the Border's CornerRadius. -->
                <Grid x:Name="GradientGrid" Panel.ZIndex="-1" Margin="-24,-28,-24,-28">
                    <Rectangle x:Name="GradientLayerA" />
                    <Rectangle x:Name="GradientLayerB" Opacity="0" />
                </Grid>

                <Grid x:Name="PlayerGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Toast overlay: floats above all player content, anchored to the top -->
                    <StackPanel x:Name="ToastOverlayPanel"
                            Grid.RowSpan="6"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,0"
                            Panel.ZIndex="100"
                            IsHitTestVisible="True" />

                    <Grid Grid.Row="0"
                          Margin="0,16,0,24">
                        <Viewbox x:Name="CoverViewbox"
                                 Stretch="Uniform"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="420" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="PrevPanelHost"
                                        Grid.Column="0"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom" />

                                <Border x:Name="CoverBorder"
                                        Grid.Column="2"
                                        Width="420"
                                        Height="420"
                                        CornerRadius="10"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True">
                                    <Border.Background>
                                        <SolidColorBrush Color="#22000000" />
                                    </Border.Background>
                                    <Grid x:Name="CoverImageGrid">
                                        <Grid.Clip>
                                            <RectangleGeometry Rect="0,0,420,420" RadiusX="10" RadiusY="10" />
                                        </Grid.Clip>
                                        <Image x:Name="ImgCoverA"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Opacity="1" />
                                        <Image x:Name="ImgCoverB"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               SnapsToDevicePixels="True"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Opacity="0" />
                                        <Border x:Name="CoverContextMenuHost" Background="Transparent">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Save cover image..." Click="SaveCoverMenuItem_Click" />
                                                    <MenuItem Header="Copy track info" Click="CopyCoverInfoMenuItem_Click" />
                                                    <MenuItem Header="Edit metadata..." Click="EditMetadataMenuItem_Click" />
                                                    <MenuItem Header="Save song to PC..." Click="SaveTrackMenuItem_Click" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border x:Name="NextPanelHost"
                                        Grid.Column="4"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Bottom" />
                            </Grid>
                        </Viewbox>

                        <Grid x:Name="LyricsViewHost"
                              Visibility="Collapsed"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              MaxWidth="600">
                            <ScrollViewer x:Name="LyricsScroller"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False"
                                          IsHitTestVisible="True"
                                          PanningMode="VerticalOnly">
                                <StackPanel x:Name="LyricsItemsHost"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                            <TextBlock x:Name="LyricsEmptyState"
                                       Text="No lyrics found for this track"
                                       FontSize="14"
                                       Opacity="0.6"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <TextBlock x:Name="TxtTitle"
                           Grid.Row="1"
                           Margin="0,0,0,6"
                           FontSize="22"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" />

                    <!-- Artist (no opacity dim, like screenshot) -->
                    <TextBlock x:Name="TxtArtist"
                           Grid.Row="2"
                           Margin="0,0,0,2"
                           FontSize="14"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.85"
                           Text="{Binding Artist}" />

                    <!-- Album, slightly smaller, dimmer, centered -->
                    <TextBlock x:Name="TxtAlbum"
                           Grid.Row="3"
                           Margin="0,0,0,10"
                           FontSize="13"
                           Opacity="0.7"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Album}" />

                    <!-- Connection info + Audio link row -->
                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,14">
                        <!-- Connection info pill button; color set in code-behind to match connection status -->
                        <Button x:Name="BtnConnectionInfo"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="0,0,8,0"
                                Click="BtnConnectionInfo_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ConnectionDot"
                                         Width="7" Height="7"
                                         Fill="Gray"
                                         VerticalAlignment="Center"
                                         Margin="0,0,5,0" />
                                <TextBlock x:Name="TxtConnectionLabel"
                                           Text="Connection"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="White" />
                            </StackPanel>
                        </Button>

                        <!-- Audio link toggle button; icon swaps in code-behind -->
                        <Button x:Name="BtnAudioLink"
                                Style="{StaticResource PillButtonStyle}"
                                Click="BtnAudioLink_Click">
                            <StackPanel x:Name="AudioLinkContent"
                                        Orientation="Horizontal" />
                        </Button>

                        <!-- Quick audio-quality button; shows current preset name (or "Custom") -->
                        <Button x:Name="BtnAudioQuality"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="Audio quality preset"
                                Click="BtnAudioQuality_Click">
                            <StackPanel x:Name="AudioQualityContent"
                                        Orientation="Horizontal" />
                        </Button>

                        <!-- Always-on-top toggle, lives in the same pill row -->
                        <Button x:Name="BtnAlwaysOnTop"
                                Style="{StaticResource PillButtonStyle}"
                                Margin="8,0,0,0"
                                ToolTip="Keep window always on top"
                                Click="BtnAlwaysOnTop_Click">
                            <StackPanel x:Name="AlwaysOnTopContent"
                                        Orientation="Horizontal" />
                        </Button>
                    </StackPanel>

                    <!-- Audio quality preset picker popup -->
                    <Popup x:Name="AudioQualityPopup"
                           Grid.Row="4"
                           PlacementTarget="{Binding ElementName=BtnAudioQuality}"
                           Placement="Top"
                           VerticalOffset="-8"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource ThemeControlBackgroundBrush}"
                                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="6"
                                MinWidth="280">
                            <StackPanel x:Name="AudioQualityMenuItems" Orientation="Vertical" />
                        </Border>
                    </Popup>

                    <!-- Connection info overlay popup -->
                    <Popup x:Name="ConnectionInfoPopup"
                           Grid.Row="4"
                           PlacementTarget="{Binding ElementName=BtnConnectionInfo}"
                           Placement="Top"
                           VerticalOffset="-8"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="#EE1E1E1E"
                                BorderBrush="#55FFFFFF"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,12"
                                MinWidth="220">
                            <StackPanel>
                                <TextBlock x:Name="TxtConnectionStatus"
                                           Text="Status: Unknown"
                                           FontSize="13"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtConnectionDetail"
                                           Text=""
                                           FontSize="11"
                                           Foreground="#AAFFFFFF"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Bottom area: progress bar + transport controls. Constrained to cover width (420). -->
                    <StackPanel Grid.Row="5"
                            Orientation="Vertical"
                            HorizontalAlignment="Center"
                            MaxWidth="420">
                        <!-- Progress row: 1:19  ====O===========  7:01 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnPositionLabel"
                                    Grid.Column="0"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0"
                                    Click="BtnPositionLabel_Click">
                                <TextBlock x:Name="TxtPositionLabel"
                                       Text="{Binding PositionLabel}"
                                       FontSize="12"
                                       Opacity="0.85"
                                       VerticalAlignment="Center" />
                            </Button>

                            <Grid Grid.Column="1">
                                <Slider x:Name="ProgressSlider"
                                    Style="{StaticResource RoundedProgressSliderStyle}"
                                    Minimum="0"
                                    Maximum="1"
                                    Value="0"
                                    IsMoveToPointEnabled="False"
                                    Focusable="False"
                                    Cursor="No"
                                    VerticalAlignment="Center"
                                    ToolTip="Seeking isn't supported"
                                    ToolTipService.InitialShowDelay="200"
                                    ToolTipService.BetweenShowDelay="0"
                                    ToolTipService.ShowDuration="4000"
                                    PreviewMouseDown="ProgressSlider_PreviewMouseDown" />

                                <Border x:Name="SeekUnsupportedNotice"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    Margin="0,-26,0,0"
                                    Background="#CC000000"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    IsHitTestVisible="False"
                                    Opacity="0">
                                    <TextBlock Text="Seeking isn't supported"
                                           FontSize="11"
                                           Foreground="White" />
                                </Border>
                            </Grid>

                            <TextBlock x:Name="TxtDurationLabel"
                                   Grid.Column="2"
                                   Text="{Binding DurationLabel}"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                        </Grid>

                        <!-- Transport row: volume on far left, prev/play/next centered, lyrics on far right -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnVolume"
                                Grid.Column="0"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Left"
                                ToolTip="Volume"
                                Click="BtnVolume_Click" />

                            <Popup x:Name="VolumePopup"
                               Grid.Column="0"
                               PlacementTarget="{Binding ElementName=BtnVolume}"
                               Placement="Top"
                               VerticalOffset="-8"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThemeControlBackgroundBrush}"
                                    BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="14,10">
                                    <Grid>
                                        <!-- Slider variant: shown when scrcpy audio session is reachable. -->
                                        <StackPanel x:Name="VolumeSliderHost"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <Slider x:Name="VolumeSlider"
                                                Style="{StaticResource RoundedVolumeSliderStyle}"
                                                Width="160"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                SmallChange="1"
                                                LargeChange="5"
                                                IsMoveToPointEnabled="True"
                                                VerticalAlignment="Center"
                                                ValueChanged="VolumeSlider_ValueChanged" />
                                            <TextBlock x:Name="TxtVolumePercent"
                                                   Text="0%"
                                                   FontSize="12"
                                                   Width="40"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Margin="10,0,0,0"
                                                   Opacity="0.85" />
                                        </StackPanel>

                                        <!-- Step-only variant: shown when scrcpy is not active. -->
                                        <StackPanel x:Name="VolumeStepHost"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed">
                                            <Button x:Name="BtnVolumeDown"
                                                Style="{StaticResource TransportIconButtonStyle}"
                                                Width="36"
                                                Height="36"
                                                Content="−"
                                                FontSize="20"
                                                ToolTip="Volume down"
                                                Click="BtnVolumeDown_Click" />
                                            <TextBlock Text="Volume"
                                                   FontSize="12"
                                                   Margin="12,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="0.85" />
                                            <Button x:Name="BtnVolumeUp"
                                                Style="{StaticResource TransportIconButtonStyle}"
                                                Width="36"
                                                Height="36"
                                                Content="+"
                                                FontSize="20"
                                                ToolTip="Volume up"
                                                Click="BtnVolumeUp_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Popup>

                            <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                                <!-- Skip-back 30 s — shown only for tracks > 10 min -->
                                <Button x:Name="BtnSeekBack"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Width="56"
                                    Height="56"
                                    Margin="0,0,4,0"
                                    Visibility="Collapsed"
                                    ToolTip="Skip back 30 s"
                                    Click="BtnSeekBack_Click" />
                                <Button x:Name="BtnPrevious"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Width="56"
                                    Height="56"
                                    Margin="0,0,16,0"
                                    Click="BtnPrevious_Click" />
                                <Button x:Name="BtnPause"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Width="72"
                                    Height="72"
                                    Margin="0,0,16,0"
                                    Click="BtnPause_Click" />
                                <Button x:Name="BtnNext"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Width="56"
                                    Height="56"
                                    Click="BtnNext_Click" />
                                <!-- Skip-forward 30 s — shown only for tracks > 10 min -->
                                <Button x:Name="BtnSeekFwd"
                                    Style="{StaticResource TransportIconButtonStyle}"
                                    Width="56"
                                    Height="56"
                                    Margin="4,0,0,0"
                                    Visibility="Collapsed"
                                    ToolTip="Skip forward 30 s"
                                    Click="BtnSeekFwd_Click" />
                            </StackPanel>

                            <Button x:Name="BtnLyrics"
                                Grid.Column="2"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Right"
                                ToolTip="Toggle lyrics overlay"
                                Click="BtnLyrics_Click" />
                        </Grid>
                    </StackPanel>

                    <!-- Collapse settings arrow: left edge of player pane, vertically centred.
                         Visible when the settings pane is open. -->
                    <Button x:Name="BtnCollapseSettingsPane"
                            Grid.Row="0"
                            Grid.RowSpan="6"
                            Style="{StaticResource PaneToggleArrowButtonStyle}"
                            Width="28"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            ToolTip="Hide settings"
                            Click="BtnCollapseSettingsPane_Click" />

                    <!-- Open settings arrow: left edge of player pane, vertically centred.
                         Visible when the settings pane is closed. -->
                    <Button x:Name="BtnShowSettingsPane"
                            Grid.Row="0"
                            Grid.RowSpan="6"
                            Style="{StaticResource PaneToggleArrowButtonStyle}"
                            Width="28"
                            Height="36"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            ToolTip="Show settings"
                            Click="BtnShowSettingsPane_Click" />

                    <!-- Collapse player-settings arrow: right edge, visible when right pane open -->
                    <Button x:Name="BtnCollapsePlayerSettingsPane"
                            Grid.Row="0"
                            Grid.RowSpan="6"
                            Style="{StaticResource PaneToggleArrowButtonStyle}"
                            Width="28"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            ToolTip="Hide player settings"
                            Click="BtnCollapsePlayerSettingsPane_Click" />

                    <!-- Show player-settings arrow: right edge, visible when right pane closed -->
                    <Button x:Name="BtnShowPlayerSettingsPane"
                            Grid.Row="0"
                            Grid.RowSpan="6"
                            Style="{StaticResource PaneToggleArrowButtonStyle}"
                            Width="28"
                            Height="36"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Panel.ZIndex="10"
                            Visibility="Visible"
                            ToolTip="Show player settings"
                            Click="BtnShowPlayerSettingsPane_Click" />

                    <!-- Help / What's this? button, top-LEFT corner of the player pane -->
                    <Button x:Name="BtnHelp"
                            Grid.Row="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Panel.ZIndex="10"
                            ToolTip="What's this? (help)"
                            Click="BtnHelp_Click" />

                    <!-- Connection top-mode icon: shown instead of the pill when PillModeConnection=3.
                         Sits left of the battery indicator. Clickable — opens the connection popup. -->
                    <Button x:Name="BtnConnectionTop"
                            Grid.Row="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,92,0"
                            Panel.ZIndex="10"
                            Visibility="Collapsed"
                            ToolTip="Connection"
                            Click="BtnConnectionTop_Click" />

                    <!-- Battery indicator, top-RIGHT corner just left of the fullscreen toggle.
                         Polled every 5 minutes; not clickable, purely informational. -->
                    <Button x:Name="BtnBattery"
                            Grid.Row="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Width="56"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,32,0"
                            Panel.ZIndex="10"
                            IsHitTestVisible="False"
                            Focusable="False"
                            ToolTip="Battery" />

                    <!-- Full-screen toggle, top-RIGHT corner. Hides the window's chrome
                         when active and restores it on the next click. -->
                    <Button x:Name="BtnFullscreen"
                            Grid.Row="0"
                            Style="{StaticResource TransportIconButtonStyle}"
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Panel.ZIndex="10"
                            ToolTip="Toggle full screen"
                            Click="BtnFullscreen_Click" />
                </Grid>

            </Grid>
        </Border>

    </Grid>
</Window>
