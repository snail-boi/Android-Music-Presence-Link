<Window x:Class="musicpresense.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Music Presence Settings" Height="540" Width="640" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeControlForegroundBrush}" />
        </Style>
        <!-- Updated ComboBox style: includes template for dropdown and item styling to respect dark theme brushes -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <ContentPresenter Name="ContentSite"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      Margin="6,0,24,0"
                                                      VerticalAlignment="Center" />
                                    <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Width="10" Height="6" Fill="{DynamicResource ThemeControlForegroundBrush}"
                                          Data="M 0 0 L 10 0 L 5 6 Z" />
                                </Grid>
                            </ToggleButton>

                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border Name="DropDownBorder"
                                        Background="{DynamicResource ThemeControlBackgroundBrush}"
                                        BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="2">
                                    <ScrollViewer Margin="0" CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="0" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Name="Bd" Background="{TemplateBinding Background}" Padding="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                            <Setter Property="Foreground" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentPressedBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Orientation="Vertical" >
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Device Selection" FontWeight="Bold" Grid.Column="0" VerticalAlignment="Center" />
                <Button x:Name="BtnAutoGather" Content="Auto Gather Info" Grid.Column="1" />
            </Grid>

            <Grid Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="USB Serial:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtUsbSerial" Grid.Row="0" Grid.Column="1" Margin="0,4" />

                <TextBlock Text="Wi-Fi (ip:port):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtWifi" Grid.Row="1" Grid.Column="1" Margin="0,4" />

                <TextBlock Text="Device Name:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" />
                <TextBox x:Name="TxtDeviceName" Grid.Row="2" Grid.Column="1" Margin="0,4" />
            </Grid>

            <TextBlock Text="Music Remote Root" FontWeight="Bold" Margin="0,0,0,4" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRemoteRoot" Grid.Column="0" Margin="0,0,8,0" />
                <Button x:Name="BtnPickRemoteRoot" Grid.Column="1" Content="Browse" Width="90" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button x:Name="BtnClearCoverCache" Content="Clear Cover Cache" Width="160" />
            </StackPanel>

            <Expander Header="Eligible Apps" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BtnRefreshApps" Content="Refresh Apps" Width="120" />
                        <TextBlock x:Name="TxtAppsStatus" Margin="12,4,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="LstAllowedApps" Height="180" Margin="0,0,0,0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding PackageName}" IsChecked="{Binding IsSelected}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Expander>

            <Expander Header="Hotkeys" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded">
                <StackPanel>
                    <TextBlock Text="Enter virtual-key codes (letters, function keys or common names). Choose modifier below." TextWrapping="Wrap" Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Modifier:" Width="140" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbHotkeyModifier" Width="220" SelectionChanged="CmbHotkeyModifier_SelectionChanged">
                            <ComboBoxItem Tag="0x0004">Shift</ComboBoxItem>
                            <ComboBoxItem Tag="0x0002">Ctrl</ComboBoxItem>
                            <ComboBoxItem Tag="0x0001">Alt</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Volume Up key:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtHotkeyVolumeUp" Width="220" />
                        <Button x:Name="BtnRecordHotkeyVolumeUp" Content="Record" Width="80" Margin="8,0,0,0" Click="BtnRecordHotkeyVolumeUp_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Volume Down key:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtHotkeyVolumeDown" Width="220" />
                        <Button x:Name="BtnRecordHotkeyVolumeDown" Content="Record" Width="80" Margin="8,0,0,0" Click="BtnRecordHotkeyVolumeDown_Click" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="Toggle Scrcpy key:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtHotkeyToggleScrcpy" Width="220" />
                        <Button x:Name="BtnRecordHotkeyToggleScrcpy" Content="Record" Width="80" Margin="8,0,0,0" Click="BtnRecordHotkeyToggleScrcpy_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Scrcpy Audio" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="BtnListCodecs" Content="List codecs" Width="120" />
                        <TextBlock x:Name="TxtCodecStatus" Margin="12,4,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListBox x:Name="LstAudioCodecs" Height="120" Margin="0,0,0,8" ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <StackPanel x:Name="PanelAudioBitrate" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Bitrate:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtAudioBitrate" Width="220" />
                        <TextBlock Text="kbps" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="PanelAudioBuffer" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Audio Buffer:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtAudioBuffer" Width="220" />
                        <TextBlock Text="ms" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="PanelFlacCompression" Orientation="Horizontal" Margin="0,0,0,0">
                        <TextBlock Text="Flac Level:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtFlacCompressionLevel" Width="220" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Update &amp; Debug" IsExpanded="False" Margin="0,0,0,12" Expanded="Expander_Expanded">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Update Interval:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" />
                        <ComboBox x:Name="CmbUpdateInterval" Grid.Row="0" Grid.Column="1" Width="220" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Paused clear delay:" Width="140" VerticalAlignment="Center" />
                        <TextBox x:Name="TxtPauseClearDelayMinutes" Width="220" />
                        <TextBlock Text="min (0 = off)" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <CheckBox x:Name="ChkDebugMode" Content="Enable debug logging" Margin="0,0,0,0" />
                    <CheckBox x:Name="ChkOpenInTaskbar" Content="Open in taskbar" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="ChkDarkMode" Content="Use dark mode" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="BtnToggleTheme" Content="Switch" Width="110" Margin="12,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave" Content="Save" Width="100" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
