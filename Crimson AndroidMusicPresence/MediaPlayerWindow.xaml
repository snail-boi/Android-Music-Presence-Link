<Window x:Class="musicpresense.MediaPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Player"
        Width="1080"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="PaneToggleArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Opacity="0.75">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeControlForegroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Opacity="0.92">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SettingsColumn" Width="500" MinWidth="0" />
            <ColumnDefinition x:Name="SplitterColumn" Width="8" MinWidth="0" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SettingsPaneBorder"
                Grid.Column="0"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource ThemeControlBackgroundBrush}">
            <ContentControl x:Name="SettingsHost" />
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      Background="Transparent"
                      DragCompleted="SettingsSplitter_DragCompleted" />

        <Border x:Name="PlayerPaneBorder"
                Grid.Column="2"
                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Background="{DynamicResource ThemeControlBackgroundBrush}"
                Padding="24,28,24,28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cover art, takes the largest share, no border, just rounded corners -->
                <Viewbox Grid.Row="0"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Margin="0,0,0,24">
                    <Border x:Name="CoverBorder"
                            Width="420"
                            Height="420"
                            CornerRadius="10"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Border.Background>
                            <SolidColorBrush Color="#22000000" />
                        </Border.Background>
                        <Image x:Name="ImgCover"
                               Stretch="UniformToFill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Save cover image..." Click="SaveCoverMenuItem_Click" />
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                    </Border>
                </Viewbox>

                <!-- Track title, big and bold, centered -->
                <TextBlock x:Name="TxtTitle"
                           Grid.Row="1"
                           Margin="0,0,0,6"
                           FontSize="22"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="-" />

                <!-- Artist (no opacity dim, like screenshot) -->
                <TextBlock x:Name="TxtArtist"
                           Grid.Row="2"
                           Margin="0,0,0,2"
                           FontSize="14"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.85"
                           Text="-" />

                <!-- Album, slightly smaller, dimmer, centered -->
                <TextBlock x:Name="TxtAlbum"
                           Grid.Row="3"
                           Margin="0,0,0,18"
                           FontSize="13"
                           Opacity="0.7"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Text="-" />

                <!-- Bottom area: progress bar + transport controls -->
                <StackPanel Grid.Row="4" Orientation="Vertical">
                    <!-- Progress row: 1:19  ====O===========  7:01 -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtPositionLabel"
                                   Grid.Column="0"
                                   Text="0:00"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <Slider x:Name="ProgressSlider"
                                Grid.Column="1"
                                Minimum="0"
                                Maximum="1"
                                Value="0"
                                IsMoveToPointEnabled="True"
                                IsHitTestVisible="False"
                                Focusable="False"
                                Cursor="Arrow"
                                VerticalAlignment="Center" />

                        <TextBlock x:Name="TxtDurationLabel"
                                   Grid.Column="2"
                                   Text="0:00"
                                   FontSize="12"
                                   Opacity="0.85"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </Grid>

                    <!-- Transport buttons: just prev / play / next, centered, plain icons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Button x:Name="BtnPrevious"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="56"
                                Height="56"
                                Margin="0,0,28,0"
                                Click="BtnPrevious_Click" />
                        <Button x:Name="BtnPause"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="72"
                                Height="72"
                                Margin="0,0,28,0"
                                Click="BtnPause_Click" />
                        <Button x:Name="BtnNext"
                                Style="{StaticResource TransportIconButtonStyle}"
                                Width="56"
                                Height="56"
                                Click="BtnNext_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Button x:Name="BtnShowSettingsPane"
                Grid.Column="2"
                Style="{StaticResource PaneToggleArrowButtonStyle}"
                Width="28"
                Height="36"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Margin="8,8,0,0"
                Visibility="Collapsed"
                ToolTip="Show settings"
                Click="BtnShowSettingsPane_Click" />
    </Grid>
</Window>
