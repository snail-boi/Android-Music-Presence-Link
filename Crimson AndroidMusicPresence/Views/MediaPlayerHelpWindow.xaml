<Window x:Class="musicpresense.MediaPlayerHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Media Player Help"
        Width="560"
        Height="780"
        MinWidth="440"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <!-- Section heading -->
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>

        <!-- The first heading needs less top margin so it doesn't push the
             content down inside the scroll viewer. -->
        <Style x:Key="FirstSectionHeading" TargetType="TextBlock"
               BasedOn="{StaticResource SectionHeading}">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <!-- Each item is a two-column row: the bold label, then the body text. -->
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>

        <Style x:Key="ItemBody" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        </Style>

        <!-- Card around each section so the dialog feels like the rest of
             the app's settings cards. -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <!-- Close button matches the accent style used elsewhere. -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeAccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThemeAccentPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title block -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Media Player Help"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="{DynamicResource ThemeForegroundBrush}" />
            <TextBlock Text="A quick guide to what each button and control does."
                       Opacity="0.7"
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource ThemeForegroundBrush}" />
        </StackPanel>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- BUTTONS & CONTROLS -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Buttons and controls" Style="{StaticResource FirstSectionHeading}" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cover art" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Shows the current track's artwork. Right-click to save the image or copy track info." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Connection pill" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Shows your USB or Wi-Fi status. Click for details." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Audio Link" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Starts or stops streaming your phone's audio through this PC. If the connection drops unexpectedly, auto-recovery will try to reconnect on its own. Auto-recovery can be disabled in Settings, and is automatically disabled when the polling interval is set above 1 second." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Audio quality" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Shows the current preset (or &quot;Custom&quot;). Click to switch presets without opening Settings. Changes apply on the next Audio Link start; if Audio Link is already on, it restarts automatically." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Volume icon" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Opens a volume slider. Shows PC-side audio session volume when Audio Link is active, or phone volume otherwise." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Seek buttons" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Skip back and skip forward by 30 seconds. Visibility is controlled by the threshold set in Player Settings. By default they appear only on tracks longer than a set duration." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Lyrics icon" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Toggles the inline lyrics view in place of the cover." />
                        </Grid>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Position label" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="The time on the left of the progress bar. Click it to switch between elapsed time and time remaining." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- WINDOW OPTIONS -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Window options" Style="{StaticResource FirstSectionHeading}" />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Full screen icon" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Top-right corner. Hides the title bar and borders. Click again to restore. The window keeps its size and stays resizable from the edges. While decorations are hidden, drag the window by clicking and holding any empty area." />
                        </Grid>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Always on top" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Keeps the window above other windows." />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SETTINGS PANEL -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Settings panel" Style="{StaticResource FirstSectionHeading}" />
                        <TextBlock Style="{StaticResource ItemBody}"
                                   Text="Open the full app settings by clicking the arrow on the left edge of the window (or the right edge if the layout is swapped)." />
                    </StackPanel>
                </Border>

                <!-- PLAYER SETTINGS -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Player settings" Style="{StaticResource FirstSectionHeading}" />
                        <TextBlock Style="{StaticResource ItemBody}" Margin="0,0,0,10"
                                   Text="Open the player settings by clicking the arrow on the right edge of the window (or the left edge if the layout is swapped). Settings here affect only the media player window." />

                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pill buttons" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Control which status pills are shown and in which mode: Full (pill visible), Mini (icon only), or Off." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Track info" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Toggle title, artist, and album labels individually. Artist and album display order can also be swapped." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Cover" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Toggle cover art visibility, rounded corners, a drop shadow behind the cover, and a text shadow on the track labels. Gradient detail controls how many color samples are used for the background gradient." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Controls" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Toggle individual buttons: volume, lyrics, battery indicator, help, fullscreen, and seek buttons." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Seek visibility" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Sets the minimum track duration at which the seek buttons appear. Enter a value and toggle between seconds and minutes." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Time format" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Switch the position label between elapsed time and time remaining. Also toggleable by clicking the label directly." />
                        </Grid>

                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Layout" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Switch settings location swaps which side the app settings and player settings panels open on." />
                        </Grid>

                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Next / Prev song" Style="{StaticResource ItemLabel}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource ItemBody}"
                                       Text="Shows a panel with the previous and next track based on a local library scan. May not always be 100% accurate. Requires a library scan; use the Rescan button after adding new music." />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Close"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    IsCancel="True" />
        </Grid>
    </Grid>
</Window>
