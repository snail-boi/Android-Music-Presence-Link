<Application x:Class="musicpresense.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="ThemeForegroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ThemeControlBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ThemeControlForegroundBrush" Color="#1A1A1A" />
        <SolidColorBrush x:Key="ThemeControlBorderBrush" Color="#C8C8C8" />
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#2D6CDF" />
        <SolidColorBrush x:Key="ThemeAccentHoverBrush" Color="#3E7BFF" />
        <SolidColorBrush x:Key="ThemeAccentPressedBrush" Color="#1F5DD1" />
    </Application.Resources>
</Application>
