<UserControl x:Class="musicpresense.MediaPlayerSettingsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ThemeControlBackgroundBrush}"
             Foreground="{DynamicResource ThemeForegroundBrush}">
    <UserControl.Resources>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Cycle button: cycles through Full / Mini / Off -->
        <Style x:Key="CycleButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle row: label on left, toggle on right -->
        <Style x:Key="ToggleRowStyle" TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,0" />
        </Style>

        <!-- Gradient step button style (segmented control look) -->
        <Style x:Key="StepButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="8,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Input textbox style -->
        <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Expander style matching MainWindow -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand"
                                              Focusable="False"
                                              OverridesDefaultStyle="True"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HBd" Background="Transparent" Padding="14,12" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                      VerticalAlignment="Center"
                                                                      TextBlock.FontWeight="SemiBold"
                                                                      TextBlock.FontSize="14"
                                                                      TextBlock.Foreground="{DynamicResource ThemeForegroundBrush}" />
                                                    <Path x:Name="Arrow"
                                                          Grid.Column="1"
                                                          Width="10" Height="6"
                                                          VerticalAlignment="Center"
                                                          Fill="{DynamicResource ThemeControlForegroundBrush}"
                                                          Data="M 0 0 L 10 0 L 5 6 Z"
                                                          RenderTransformOrigin="0.5,0.5">
                                                        <Path.RenderTransform>
                                                            <RotateTransform Angle="-90" />
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HBd" Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="ContentSite"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Padding="14,4,14,14">
                                    <Border BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12,0,0">
                                        <ContentPresenter />
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,12">

            <!-- ── PILL BUTTONS ──────────────────────────────────────────────── -->
            <Expander Header="Pill buttons" IsExpanded="True" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Connection" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnPillConnection"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="BtnPillConnection_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Audio link" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnPillAudioLink"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="BtnPillAudioLink_Click" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Quality" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnPillQuality"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="BtnPillQuality_Click" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Always on top" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnPillAlwaysOnTop"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="BtnPillAlwaysOnTop_Click" />
                    </Grid>

                </StackPanel>
            </Expander>

            <!-- ── TRACK INFO ─────────────────────────────────────────────────── -->
            <Expander Header="Track info" IsExpanded="False" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Title" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowTitle"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowTitle_Changed"
                                  Unchecked="ChkShowTitle_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Artist" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowArtist"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowArtist_Changed"
                                  Unchecked="ChkShowArtist_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Album" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowAlbum"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowAlbum_Changed"
                                  Unchecked="ChkShowAlbum_Changed" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Swap artist and album" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkSwapArtistAlbum"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkSwapArtistAlbum_Changed"
                                  Unchecked="ChkSwapArtistAlbum_Changed" />
                    </Grid>

                </StackPanel>
            </Expander>

            <!-- ── COVER ──────────────────────────────────────────────────────── -->
            <Expander Header="Cover" IsExpanded="False" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show cover" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowCover"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowCover_Changed"
                                  Unchecked="ChkShowCover_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rounded corners" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkCoverRounded"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkCoverRounded_Changed"
                                  Unchecked="ChkCoverRounded_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Cover shadow" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkCoverShadow"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkCoverShadow_Changed"
                                  Unchecked="ChkCoverShadow_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Text shadow" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkTextShadow"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkTextShadow_Changed"
                                  Unchecked="ChkTextShadow_Changed" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Gradient detail" Style="{StaticResource RowLabel}" VerticalAlignment="Center" />
                        <Border Grid.Column="1"
                                BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnGrad8"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="8"
                                        Tag="8"
                                        Click="BtnGradient_Click" />
                                <Border Width="1" Background="{DynamicResource ThemeControlBorderBrush}" />
                                <Button x:Name="BtnGrad6"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="6"
                                        Tag="6"
                                        Click="BtnGradient_Click" />
                                <Border Width="1" Background="{DynamicResource ThemeControlBorderBrush}" />
                                <Button x:Name="BtnGrad4"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="4"
                                        Tag="4"
                                        Click="BtnGradient_Click" />
                                <Border Width="1" Background="{DynamicResource ThemeControlBorderBrush}" />
                                <Button x:Name="BtnGrad2"
                                        Style="{StaticResource StepButtonStyle}"
                                        Content="2"
                                        Tag="2"
                                        Click="BtnGradient_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </Expander>

            <!-- ── CONTROLS ───────────────────────────────────────────────────── -->
            <Expander Header="Controls" IsExpanded="False" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Volume button" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowVolume"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowVolume_Changed"
                                  Unchecked="ChkShowVolume_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Lyrics button" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowLyrics"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowLyrics_Changed"
                                  Unchecked="ChkShowLyrics_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Battery indicator" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowBattery"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowBattery_Changed"
                                  Unchecked="ChkShowBattery_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Help button" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowHelp"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowHelp_Changed"
                                  Unchecked="ChkShowHelp_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Fullscreen button" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowFullscreen"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowFullscreen_Changed"
                                  Unchecked="ChkShowFullscreen_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seek buttons" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkShowSeekButtons"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkShowSeekButtons_Changed"
                                  Unchecked="ChkShowSeekButtons_Changed" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Seek button visibility" Style="{StaticResource RowLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TxtSeekButtonThreshold"
                                     Width="70"
                                     TextAlignment="Center"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     TextChanged="TxtSeekButtonThreshold_Changed" />
                            <Button x:Name="BtnSeekThresholdUnit"
                                    Margin="4,0,0,0"
                                    MinWidth="45"
                                    Padding="6,0"
                                    Style="{StaticResource CycleButtonStyle}"
                                    Click="BtnSeekThresholdUnit_Click"
                                    Content="sec" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Time format (click to toggle)" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnTimeFormat"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Content="Elapsed"
                                Click="BtnTimeFormat_Click" />
                    </Grid>

                </StackPanel>
            </Expander>

            <!-- ── LAYOUT ─────────────────────────────────────────────────────── -->
            <Expander Header="Layout" IsExpanded="False" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Switch settings location" Style="{StaticResource RowLabel}" />
                        <CheckBox x:Name="ChkSwapSettingsLocation"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitchStyle}"
                                  Checked="ChkSwapSettingsLocation_Changed"
                                  Unchecked="ChkSwapSettingsLocation_Changed" />
                    </Grid>

                </StackPanel>
            </Expander>

            <!-- ── NEXT / PREVIOUS SONG ──────────────────────────────────────── -->
            <Expander Header="Next / previous song" IsExpanded="False" Margin="0,0,0,8" Expanded="Expander_Expanded">
                <StackPanel>

                    <TextBlock Text="Based on a local library scan. May not always be 100% accurate. Order within the same date may differ slightly from your player."
                               FontSize="11"
                               Opacity="0.55"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mode" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BtnNextSongMode"
                                Grid.Column="1"
                                Style="{StaticResource CycleButtonStyle}"
                                Click="BtnNextSongMode_Click" />
                    </Grid>

                    <!-- Sort and rescan: only visible when mode is not Off -->
                    <StackPanel x:Name="PanelNextSongOptions" Visibility="Collapsed">

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Sort order" Style="{StaticResource RowLabel}" />
                            <Button x:Name="BtnNextSongSort"
                                    Grid.Column="1"
                                    Style="{StaticResource CycleButtonStyle}"
                                    Click="BtnNextSongSort_Click" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Library list" Style="{StaticResource RowLabel}" />
                                <TextBlock x:Name="TxtNextSongListStatus"
                                           FontSize="11"
                                           Opacity="0.55"
                                           Margin="0,2,0,0" />
                                <TextBlock Text="Scanning can be slow on large libraries."
                                           FontSize="11"
                                           Opacity="0.45"
                                           TextWrapping="Wrap"
                                           MaxWidth="200"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                            <Button x:Name="BtnRescanLibrary"
                                    Grid.Column="1"
                                    Style="{StaticResource CycleButtonStyle}"
                                    Content="Rescan"
                                    Click="BtnRescanLibrary_Click" />
                        </Grid>

                    </StackPanel>

                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
