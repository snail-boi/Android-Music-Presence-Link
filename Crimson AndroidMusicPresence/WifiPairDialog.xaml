<Window x:Class="musicpresense.WifiPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Wireless Debugging" Height="360" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5539cc"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <StackPanel>
            <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                       Text="Pair this PC with your phone"/>

            <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12" Margin="0,0,0,12">
                On your phone, open <Run FontWeight="SemiBold">Developer options</Run>,
                tap <Run FontWeight="SemiBold">Wireless debugging</Run>, then
                <Run FontWeight="SemiBold">Pair device with pairing code</Run>.
                Type the IP and port shown there (top line) and the 6-digit code below.
            </TextBlock>

            <TextBlock Text="Pairing address (ip:port):" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPairAddress" Margin="0,0,0,12"/>

            <TextBlock Text="Pairing code (6 digits):" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtPairCode" Margin="0,0,0,12" MaxLength="10"/>

            <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Opacity="0.9"
                       FontSize="12" Foreground="#FFB347" Margin="0,4,0,8"
                       Text=""/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#444" Width="80"/>
                <Button x:Name="BtnPair" Content="Pair" Click="BtnPair_Click" IsDefault="True" Width="80"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
