<Window x:Class="musicpresense.WifiPairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Wireless Debugging" Height="460" Width="460"
        WindowStartupLocation="CenterOwner"
        Background="#111111"
        ResizeMode="NoResize"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5539cc"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <StackPanel>
            <TextBlock FontWeight="Bold" FontSize="14" Margin="0,0,0,8"
                       Text="Pair this PC with your phone"/>

            <!-- QR mode panel -->
            <StackPanel x:Name="PanelQr">
                <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12" Margin="0,0,0,12">
                    On your phone, open <Run FontWeight="SemiBold">Developer options</Run>,
                    tap <Run FontWeight="SemiBold">Wireless debugging</Run>, then
                    <Run FontWeight="SemiBold">Pair device with QR code</Run>.
                    Scan the code below.
                </TextBlock>

                <Border Background="#1a1a1a" BorderBrush="#333" BorderThickness="1"
                        CornerRadius="6" Padding="12" Margin="0,0,0,12"
                        HorizontalAlignment="Center">
                    <Image x:Name="ImgQrCode" Width="200" Height="200"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Stretch="Uniform"/>
                </Border>

                <TextBlock x:Name="TxtQrStatus" TextWrapping="Wrap" Opacity="0.9"
                           FontSize="12" Foreground="#FFB347" Margin="0,0,0,8"
                           HorizontalAlignment="Center" Text="Waiting for phone to scan..."/>
            </StackPanel>

            <!-- Manual IP/port mode panel -->
            <StackPanel x:Name="PanelManual" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" Opacity="0.85" FontSize="12" Margin="0,0,0,12">
                    On your phone, open <Run FontWeight="SemiBold">Developer options</Run>,
                    tap <Run FontWeight="SemiBold">Wireless debugging</Run>, then
                    <Run FontWeight="SemiBold">Pair device with pairing code</Run>.
                    Enter the IP:port (top line) and the 6-digit code shown there.
                </TextBlock>

                <TextBlock Text="Pairing address (ip:port):" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPairAddress" Margin="0,0,0,12"/>

                <TextBlock Text="Pairing code (6 digits):" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtPairCode" Margin="0,0,0,12" MaxLength="10"/>

                <TextBlock x:Name="TxtManualStatus" TextWrapping="Wrap" Opacity="0.9"
                           FontSize="12" Foreground="#FFB347" Margin="0,4,0,8" Text=""/>
            </StackPanel>

            <!-- Mode toggle link -->
            <TextBlock x:Name="TxtModeToggle"
                       FontSize="12" Foreground="#9988ee" Cursor="Hand"
                       Margin="0,0,0,12" HorizontalAlignment="Center"
                       Text="Use IP/port and code instead"
                       MouseLeftButtonUp="TxtModeToggle_Click"
                       TextDecorations="Underline"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Click="BtnCancel_Click" Background="#444" Width="80"/>
                <Button x:Name="BtnPair" Content="Pair" Click="BtnPair_Click"
                        IsDefault="True" Width="80" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
