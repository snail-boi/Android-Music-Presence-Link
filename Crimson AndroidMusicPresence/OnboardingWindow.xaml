<Window x:Class="musicpresense.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Android Music Presence"
        Width="880"
        Height="640"
        MinWidth="720"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource ThemeBackgroundBrush}"
        Foreground="{DynamicResource ThemeForegroundBrush}"
        FontFamily="Segoe UI">

	<Window.Resources>
		<!-- Card style for content sections -->
		<Style x:Key="CardBorder" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="20" />
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="0" Opacity="0.06" />
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Pretty primary button -->
		<Style x:Key="PrimaryButton" TargetType="Button">
			<Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="18,8" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="MinWidth" Value="100" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Opacity" Value="0.45" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Secondary button -->
		<Style x:Key="SecondaryButton" TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="14,8" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="MinHeight" Value="34" />
			<Setter Property="MinWidth" Value="90" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#11000000" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#22000000" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Opacity" Value="0.4" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Numbered step circle -->
		<Style x:Key="StepNumberCircle" TargetType="Border">
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="CornerRadius" Value="14" />
			<Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
			<Setter Property="VerticalAlignment" Value="Top" />
		</Style>

		<Style x:Key="StepNumberText" TargetType="TextBlock">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="InstructionText" TargetType="TextBlock">
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="LineHeight" Value="20" />
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Margin" Value="0,0,12,0" />
		</Style>

		<Style x:Key="HelperText" TargetType="TextBlock">
			<Setter Property="Opacity" Value="0.7" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,4,0,0" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBorderBrush}" />
			<Setter Property="Background" Value="{DynamicResource ThemeControlBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
		</Style>

		<Style TargetType="ComboBox">
			<Setter Property="MinHeight" Value="30" />
			<Setter Property="Padding" Value="8,4" />
		</Style>

		<Style TargetType="CheckBox">
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
		</Style>

		<Style TargetType="RadioButton">
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
		</Style>

		<Style TargetType="ListBox">
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="2" />
			<Setter Property="ScrollViewer.CanContentScroll" Value="True" />
		</Style>

		<Style TargetType="ListBoxItem">
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Padding" Value="4,3" />
			<Setter Property="Margin" Value="0,1" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Border x:Name="ItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="4"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentHoverBrush}" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
								<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
								<Setter Property="Foreground" Value="White" />
							</Trigger>
							<MultiTrigger>
								<MultiTrigger.Conditions>
									<Condition Property="IsSelected" Value="True" />
									<Condition Property="Selector.IsSelectionActive" Value="False" />
								</MultiTrigger.Conditions>
								<Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ThemeAccentPressedBrush}" />
								<Setter Property="Foreground" Value="White" />
							</MultiTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="220" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!-- LEFT SIDEBAR with step list -->
		<Border Grid.Column="0" Background="{DynamicResource ThemeAccentBrush}">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<StackPanel Grid.Row="0" Margin="24,32,24,24">
					<TextBlock Text="Setup"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White" />
					<TextBlock Text="Android Music Presence"
                               FontSize="12"
                               Foreground="White"
                               Opacity="0.85"
                               Margin="0,2,0,0" />
				</StackPanel>

				<ItemsControl x:Name="LstSidebarSteps" Grid.Row="1" Margin="16,0,16,16"
                              Background="Transparent"
                              BorderThickness="0">
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Padding="12,10" Margin="0,2" CornerRadius="6"
                                    Background="{Binding RowBackground}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="26" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>

									<Border Grid.Column="0" Width="22" Height="22" CornerRadius="11"
                                            Background="{Binding NumberBackground}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
										<TextBlock Text="{Binding NumberText}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding NumberForeground}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
									</Border>

									<TextBlock Grid.Column="1"
                                               Text="{Binding Title}"
                                               Foreground="White"
                                               Opacity="{Binding TitleOpacity}"
                                               FontWeight="{Binding TitleWeight}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Grid.Row="2"
                           Text="You can change everything later in Settings."
                           Foreground="White"
                           Opacity="0.7"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="24,0,24,24" />
			</Grid>
		</Border>

		<!-- RIGHT CONTENT AREA -->
		<Grid Grid.Column="1" Margin="32,28,32,20">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Header -->
			<StackPanel Grid.Row="0" Margin="0,0,0,16">
				<TextBlock x:Name="TxtStepTitle" FontSize="26" FontWeight="Bold" />
				<TextBlock x:Name="TxtStepSubtitle" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" FontSize="14" />
			</StackPanel>

			<!-- Content card -->
			<Border Grid.Row="1" Style="{StaticResource CardBorder}">
				<Grid>

					<!-- =================================================== -->
					<!-- STEP 0: WELCOME                                       -->
					<!-- =================================================== -->
					<Grid x:Name="PanelWelcome" Visibility="Collapsed">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<TextBlock Text="👋 Hi there!"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           Margin="0,4,0,12" />

								<TextBlock Style="{StaticResource InstructionText}"
                                           FontSize="15"
                                           Margin="0,0,0,16">
									This app shows what music is playing on your Android phone right here on your Windows PC. It can also pull cover art, sync lyrics, control volume with hotkeys, and stream the audio over a USB or Wi-Fi link.
								</TextBlock>

								<TextBlock Text="What we will set up together:"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Margin="0,8,0,10" />

								<!-- Bullet list of features -->
								<StackPanel Margin="4,0,0,0">
									<Grid Margin="0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="📱" FontSize="16" VerticalAlignment="Top" />
										<TextBlock Grid.Column="1" Style="{StaticResource InstructionText}">
											<Run FontWeight="SemiBold">Connect your phone</Run> using a USB cable, with optional Wi-Fi for wireless control afterwards.
										</TextBlock>
									</Grid>
									<Grid Margin="0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="🎵" FontSize="16" VerticalAlignment="Top" />
										<TextBlock Grid.Column="1" Style="{StaticResource InstructionText}">
											<Run FontWeight="SemiBold">Point us at your music</Run> so we can find cover art and lyrics for your tracks.
										</TextBlock>
									</Grid>
									<Grid Margin="0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="🎧" FontSize="16" VerticalAlignment="Top" />
										<TextBlock Grid.Column="1" Style="{StaticResource InstructionText}">
											<Run FontWeight="SemiBold">Choose which apps</Run> on your phone are allowed to share what they are playing.
										</TextBlock>
									</Grid>
									<Grid Margin="0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="⌨️" FontSize="16" VerticalAlignment="Top" />
										<TextBlock Grid.Column="1" Style="{StaticResource InstructionText}">
											<Run FontWeight="SemiBold">Pick your hotkeys</Run> for volume, lyrics overlay and copying track info.
										</TextBlock>
									</Grid>
									<Grid Margin="0,4">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="28" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="🚀" FontSize="16" VerticalAlignment="Top" />
										<TextBlock Grid.Column="1" Style="{StaticResource InstructionText}">
											<Run FontWeight="SemiBold">Decide how it starts</Run>, whether to launch with Windows or stay in the tray.
										</TextBlock>
									</Grid>
								</StackPanel>

								<Border Background="#222D6CDF"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,18,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="💡" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   FontSize="13">
											Takes about 3 to 5 minutes. Don't worry if you get stuck on something, you can skip any step and come back to it later.
										</TextBlock>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 1: USB DEBUGGING INSTRUCTIONS                    -->
					<!-- =================================================== -->
					<Grid x:Name="PanelUsbDebugging" Visibility="Collapsed">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<TextBlock Style="{StaticResource InstructionText}"
                                           FontSize="14"
                                           Margin="0,0,0,18">
									To talk to your phone, Windows needs permission through something Android calls
									<Run FontWeight="SemiBold">USB debugging</Run>. It is hidden by default. Don't worry, follow these steps and you'll be ready in a minute.
								</TextBlock>

								<!-- Step 1 -->
								<Grid Margin="0,4,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Style="{StaticResource StepNumberCircle}">
										<TextBlock Text="1" Style="{StaticResource StepNumberText}" />
									</Border>
									<StackPanel Grid.Column="1">
										<TextBlock Text="Unlock the Developer Options menu"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   Margin="0,4,0,0">
											On your phone, open <Run FontWeight="SemiBold">Settings &#8250; About phone</Run>, find the
											<Run FontWeight="SemiBold">Build number</Run> entry, and tap it
											<Run FontWeight="SemiBold">7 times in a row</Run>. You'll see a little message saying "You are now a developer!".
										</TextBlock>
										<TextBlock Style="{StaticResource HelperText}">
											On Samsung phones it may be under About phone &#8250; Software information. On Xiaomi/MIUI tap MIUI version instead.
										</TextBlock>
									</StackPanel>
								</Grid>

								<!-- Step 2 -->
								<Grid Margin="0,4,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Style="{StaticResource StepNumberCircle}">
										<TextBlock Text="2" Style="{StaticResource StepNumberText}" />
									</Border>
									<StackPanel Grid.Column="1">
										<TextBlock Text="Turn on USB debugging"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   Margin="0,4,0,0">
											Go back to the main Settings screen and open <Run FontWeight="SemiBold">System &#8250; Developer options</Run>.
											Scroll down until you see <Run FontWeight="SemiBold">USB debugging</Run> and switch it on. Confirm any warning that pops up.
										</TextBlock>
									</StackPanel>
								</Grid>

								<!-- Step 3 -->
								<Grid Margin="0,4,0,16">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Style="{StaticResource StepNumberCircle}">
										<TextBlock Text="3" Style="{StaticResource StepNumberText}" />
									</Border>
									<StackPanel Grid.Column="1">
										<TextBlock Text="Plug the phone into your PC"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   Margin="0,4,0,0">
											Use a real USB data cable, not a charge-only one. If your phone asks
											<Run FontWeight="SemiBold">"Use USB for..."</Run>, choose <Run FontWeight="SemiBold">File transfer</Run> or <Run FontWeight="SemiBold">MTP</Run>.
										</TextBlock>
									</StackPanel>
								</Grid>

								<!-- Step 4 -->
								<Grid Margin="0,4,0,8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="40" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border Style="{StaticResource StepNumberCircle}">
										<TextBlock Text="4" Style="{StaticResource StepNumberText}" />
									</Border>
									<StackPanel Grid.Column="1">
										<TextBlock Text="Allow this PC to debug"
                                                   FontWeight="SemiBold"
                                                   FontSize="14" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   Margin="0,4,0,0">
											A popup on your phone will ask <Run FontWeight="SemiBold">"Allow USB debugging?"</Run>. Tick
											<Run FontWeight="SemiBold">"Always allow from this computer"</Run> and tap <Run FontWeight="SemiBold">Allow</Run>.
										</TextBlock>
										<TextBlock Style="{StaticResource HelperText}">
											If the popup never shows up, try unplugging and replugging the cable, or tap "Revoke USB debugging authorizations" in Developer options and try again.
										</TextBlock>
									</StackPanel>
								</Grid>

								<Border Background="#1A2D6CDF"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,16,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="✅" FontSize="18" VerticalAlignment="Top" Margin="0,0,10,0" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   FontSize="13">
											Once you've done that, your phone is ready. Click <Run FontWeight="SemiBold">Next</Run> and we'll detect it automatically on the following step.
										</TextBlock>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 2: DEVICE SELECTION                              -->
					<!-- =================================================== -->
					<Grid x:Name="PanelDevice" Visibility="Collapsed">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0" Style="{StaticResource InstructionText}"
                                   Margin="0,0,0,16"
                                   FontSize="14">
							Click <Run FontWeight="SemiBold">Auto Detect</Run> below and we'll find your phone, optionally set up Wi-Fi, and ask you for a friendly name. You can also fill these fields in by hand if you know what you're doing.
						</TextBlock>

						<Button Grid.Row="1"
                                x:Name="BtnAutoGather"
                                Content="🔍  Auto Detect My Phone"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,20"
                                Padding="22,10"
                                FontSize="14"
                                Click="BtnAutoGather_Click" />

						<Grid Grid.Row="2" Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Text="USB Serial" Style="{StaticResource FieldLabel}" />
								<TextBlock Text="Identifier of the cable connection." Style="{StaticResource HelperText}" Margin="0,2,8,0" />
							</StackPanel>
							<TextBox Grid.Column="1" x:Name="TxtUsbSerial" />
						</Grid>

						<Grid Grid.Row="3" Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Text="Wi-Fi Address" Style="{StaticResource FieldLabel}" />
								<TextBlock Text="Optional, format ip:port." Style="{StaticResource HelperText}" Margin="0,2,8,0" />
							</StackPanel>
							<TextBox Grid.Column="1" x:Name="TxtWifi" />
						</Grid>

						<Grid Grid.Row="4" Margin="0,0,0,12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Text="Device Name" Style="{StaticResource FieldLabel}" />
								<TextBlock Text="Anything you like, e.g. 'My Pixel'." Style="{StaticResource HelperText}" Margin="0,2,8,0" />
							</StackPanel>
							<TextBox Grid.Column="1" x:Name="TxtDeviceName" />
						</Grid>
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 3: FOLDERS                                       -->
					<!-- =================================================== -->
					<Grid x:Name="PanelFolders" Visibility="Collapsed">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0" Style="{StaticResource InstructionText}"
                                   Margin="0,0,0,12"
                                   FontSize="14">
							Tell us where your music lives on the phone so we can fetch cover art and lyrics. If you don't keep music on your device, you can skip this entirely.
						</TextBlock>

						<TextBlock Grid.Row="1"
                                   Text="Music folders on your phone"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,6" />

						<ListBox x:Name="LstRemoteRoots"
                                 Grid.Row="2"
                                 Margin="0,0,0,8"
                                 MinHeight="120"
                                 BorderBrush="{DynamicResource ThemeControlBorderBrush}"
								 Foreground="White"
                                 Background="{DynamicResource ThemeBackgroundBrush}"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                          <ListBox.ItemContainerStyle>
								<Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
								</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="2,3">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="📁" FontSize="14" Margin="2,0,8,0" VerticalAlignment="Center"/>
										<TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/>
										<Button Grid.Column="2" Content="Remove"
                                                Style="{StaticResource SecondaryButton}"
                                                MinWidth="80" Padding="10,4"
                                                Margin="8,0,0,0"
                                                Tag="{Binding}"
                                                Click="BtnRemoveRemoteRoot_Click" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>

						<Button Grid.Row="3" x:Name="BtnPickRemoteRoot"
                                Content="➕  Add Music Folder"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,16"
                                Click="BtnPickRemoteRoot_Click" />

						<Grid Grid.Row="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="160" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel Grid.Column="0" VerticalAlignment="Center">
								<TextBlock Text="Lyrics folder" Style="{StaticResource FieldLabel}" />
								<TextBlock Text="Optional override." Style="{StaticResource HelperText}" Margin="0,2,8,0" />
							</StackPanel>
							<TextBox Grid.Column="1" x:Name="TxtLyricsFolderOverride" />
							<Button Grid.Column="2"
                                    x:Name="BtnBrowseLyricsFolder"
                                    Content="Browse"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"
                                    Click="BtnBrowseLyricsFolder_Click" />
						</Grid>
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 4: APPS                                          -->
					<!-- =================================================== -->
					<Grid x:Name="PanelApps" Visibility="Collapsed">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<TextBlock Grid.Row="0" Style="{StaticResource InstructionText}"
                                   Margin="0,0,0,12"
                                   FontSize="14">
							Pick which Android apps are allowed to share what they're playing. Tick the
							<Run FontWeight="SemiBold">Allow</Run> column for music apps like Spotify or YouTube Music. Tick
							<Run FontWeight="SemiBold">Cover Search</Run> if you also want us to look up cover art for that app.
						</TextBlock>

						<Grid Grid.Row="1" Margin="0,0,0,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Button Grid.Column="0"
                                    x:Name="BtnRefreshApps"
                                    Content="🔄  Refresh App List"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnRefreshApps_Click" />
							<TextBlock Grid.Column="1"
                                       x:Name="TxtAppsStatus"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.7" />
						</Grid>

						<Grid Grid.Row="2" Margin="2,0,18,4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="140" />
								<ColumnDefinition Width="140" />
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Column="0" Text="App package" FontWeight="SemiBold" Opacity="0.8" />
							<TextBlock Grid.Column="1" Text="Allow" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Center" />
							<TextBlock Grid.Column="2" Text="Cover Search" FontWeight="SemiBold" Opacity="0.8" HorizontalAlignment="Center" />
						</Grid>

						<ListBox x:Name="LstAllowedApps"
                                 Grid.Row="3"
                                 BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                 Background="{DynamicResource ThemeBackgroundBrush}"
                                 HorizontalContentAlignment="Stretch"
                              TextSearch.TextPath="PackageName"
								 Foreground="White"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                          <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
									<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									<Setter Property="Padding" Value="0" />
							</Style>
							</ListBox.ItemContainerStyle>
							<ListBox.ItemTemplate>
								<DataTemplate>
									<Grid Margin="0,3">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="140" />
											<ColumnDefinition Width="140" />
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="{Binding PackageName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackageName}" />
										<CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
										<CheckBox Grid.Column="2" IsChecked="{Binding IsCoverSearchEnabled}" IsEnabled="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Grid>
								</DataTemplate>
							</ListBox.ItemTemplate>
						</ListBox>
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 5: HOTKEYS                                       -->
					<!-- =================================================== -->
					<Grid x:Name="PanelHotkeys" Visibility="Collapsed">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="180" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Style="{StaticResource InstructionText}"
                                   FontSize="14"
                                   Margin="0,0,0,16">
							Hotkeys are global, they work even when the app isn't focused. Click
							<Run FontWeight="SemiBold">Record</Run> next to a field, then press the key you want to use. The modifier below applies to all of them.
						</TextBlock>

						<TextBlock Grid.Row="1" Grid.Column="0" Text="Modifier key" Style="{StaticResource FieldLabel}" />
						<ComboBox x:Name="CmbHotkeyModifier" Grid.Row="1" Grid.Column="1" Margin="0,0,0,12">
							<ComboBoxItem Tag="0x0004">Shift</ComboBoxItem>
							<ComboBoxItem Tag="0x0002">Ctrl</ComboBoxItem>
							<ComboBoxItem Tag="0x0001">Alt</ComboBoxItem>
						</ComboBox>

						<TextBlock Grid.Row="2" Grid.Column="0" Text="Volume Up" Style="{StaticResource FieldLabel}" />
						<TextBox x:Name="TxtHotkeyVolumeUp" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
						<Button Grid.Row="2" Grid.Column="2" Content="Record" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Click="BtnRecordHotkeyVolumeUp_Click" />

						<TextBlock Grid.Row="3" Grid.Column="0" Text="Volume Down" Style="{StaticResource FieldLabel}" />
						<TextBox x:Name="TxtHotkeyVolumeDown" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" />
						<Button Grid.Row="3" Grid.Column="2" Content="Record" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Click="BtnRecordHotkeyVolumeDown_Click" />

						<TextBlock Grid.Row="4" Grid.Column="0" Text="Toggle Audio Link" Style="{StaticResource FieldLabel}" />
						<TextBox x:Name="TxtHotkeyToggleScrcpy" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" />
						<Button Grid.Row="4" Grid.Column="2" Content="Record" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Click="BtnRecordHotkeyToggleScrcpy_Click" />

						<TextBlock Grid.Row="5" Grid.Column="0" Text="Toggle Lyrics" Style="{StaticResource FieldLabel}" />
						<TextBox x:Name="TxtHotkeyToggleLyricsOverlay" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" />
						<Button Grid.Row="5" Grid.Column="2" Content="Record" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Click="BtnRecordHotkeyToggleLyricsOverlay_Click" />

						<TextBlock Grid.Row="6" Grid.Column="0" Text="Copy Track Info" Style="{StaticResource FieldLabel}" />
						<TextBox x:Name="TxtHotkeyCopyTrackInfo" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" />
						<Button Grid.Row="6" Grid.Column="2" Content="Record" Style="{StaticResource SecondaryButton}" Margin="8,0,0,8" Click="BtnRecordHotkeyCopyTrackInfo_Click" />
					</Grid>

					<!-- =================================================== -->
					<!-- STEP 6: STARTUP                                       -->
					<!-- =================================================== -->
					<Grid x:Name="PanelStartup" Visibility="Collapsed">
						<ScrollViewer VerticalScrollBarVisibility="Auto">
							<StackPanel>
								<TextBlock Style="{StaticResource InstructionText}"
                                           FontSize="14"
                                           Margin="0,0,0,18">
									Almost done! Choose how the app behaves when it launches. You can change these later in Settings.
								</TextBlock>

								<Border BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,12"
                                        Margin="0,0,0,10">
									<StackPanel>
										<CheckBox x:Name="ChkOpenInTaskbar"
                                                  Content="Show in taskbar"
                                                  FontWeight="SemiBold" />
										<TextBlock Style="{StaticResource HelperText}"
                                                   Margin="22,4,0,0">
											When checked, the app runs quietly in the system tray near the clock.
										</TextBlock>
									</StackPanel>
								</Border>

								<Border BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,12">
									<StackPanel>
										<CheckBox x:Name="ChkStartWithWindows"
                                                  Content="Start automatically when Windows starts"
                                                  FontWeight="SemiBold" />
										<TextBlock Style="{StaticResource HelperText}"
                                                   Margin="22,4,0,0">
											Convenient if you want music presence to be ready every time you sign in.
										</TextBlock>
									</StackPanel>
								</Border>

								<!-- Default view: settings vs. media player -->
								<Border BorderBrush="{DynamicResource ThemeControlBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="16,12"
                                        Margin="0,10,0,0">
									<StackPanel>
										<TextBlock Text="Default view"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"
                                                   Foreground="{DynamicResource ThemeForegroundBrush}" />
										<TextBlock Style="{StaticResource HelperText}"
                                                   Margin="0,0,0,10">
											Choose what opens when you launch the app. You can switch any time from the tray menu or the toggle inside each view.
										</TextBlock>

										<RadioButton x:Name="RbViewSettings"
                                                     GroupName="OnboardingDefaultView"
                                                     Content="Settings view"
                                                     FontWeight="SemiBold"
                                                     IsChecked="True" />
										<TextBlock Style="{StaticResource HelperText}"
                                                   Margin="22,2,0,8">
											Classic full settings window with all options visible.
										</TextBlock>

										<RadioButton x:Name="RbViewMediaPlayer"
                                                     GroupName="OnboardingDefaultView"
                                                     Content="Media Player view"
                                                     FontWeight="SemiBold" />
										<TextBlock Style="{StaticResource HelperText}"
                                                   Margin="22,2,0,0">
											Compact now-playing window with cover art, transport controls, and a foldable settings pane.
										</TextBlock>
									</StackPanel>
								</Border>

								<Border Background="#1A2D6CDF"
                                        CornerRadius="6"
                                        Padding="14,12"
                                        Margin="0,18,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   FontSize="13">
											That's everything. Hit <Run FontWeight="SemiBold">Finish</Run> below and you're good to go.
										</TextBlock>
									</StackPanel>
								</Border>
								<Border Background="#1A2D6CDF"
										CornerRadius="6"
										Padding="14,12"
										Margin="0,18,0,0">
									<StackPanel Orientation="Horizontal">
										<TextBlock Text="ⓘ" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
										<TextBlock Style="{StaticResource InstructionText}"
                                                   FontSize="11">
											any of these settings can be changed by rightclicking the icon in the taskbar and clicking settings
										</TextBlock>
									</StackPanel>
								</Border>
							</StackPanel>
						</ScrollViewer>
					</Grid>

				</Grid>
			</Border>

			<!-- Footer / navigation bar -->
			<Grid Grid.Row="2" Margin="0,16,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<TextBlock x:Name="TxtStepCounter"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Opacity="0.6"
                           FontSize="13" />

				<Button x:Name="BtnCancel"
                        Grid.Column="2"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="BtnCancel_Click" />
				<Button x:Name="BtnBack"
                        Grid.Column="3"
                        Content="◀  Back"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="BtnBack_Click" />
				<Button x:Name="BtnSkip"
                        Grid.Column="4"
                        Content="Skip"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Click="BtnSkip_Click" />
				<Button x:Name="BtnNext"
                        Grid.Column="5"
                        Content="Next  ▶"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Click="BtnNext_Click" />
				<Button x:Name="BtnFinish"
                        Grid.Column="5"
                        Content="✓  Finish"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Visibility="Collapsed"
                        Click="BtnFinish_Click" />
			</Grid>
		</Grid>
	</Grid>
</Window>
